@* Sidnavigering längst ner i en tråd (B28, B35): Previous till vänster, sidnumren (med …) och Next i mitten,
   Latest till höger. Länkarna framåt/bakåt används också av tangenterna ← → (page-keys.js).
   Med OnPage blir sidorna knappar i stället för länkar (B67), för en väljare inne i ett formulär som inte får lämna sidan;
   då används inte tangenterna. *@

@if (PageCount > 1)
{
    <nav class="thread-pager" aria-label="Pages">
        <div class="pager-row">
            @StepLink(Page - 1, Page > 1, prev: true)
            <ul class="pagination pagination-sm mb-0 pager-numbers">
                @foreach (var p in Paging.Window(Page, PageCount))
                {
                    if (p is { } number)
                    {
                        <li class="page-item @(number == Page ? "active" : "")">
                            @if (UsesButtons)
                            {
                                <button type="button" class="page-link" aria-current="@(number == Page ? "page" : null)" @onclick="() => OnPage.InvokeAsync(number)">@number</button>
                            }
                            else
                            {
                                <a class="page-link" href="@Href(number)" aria-current="@(number == Page ? "page" : null)">@number</a>
                            }
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                <li class="page-item @(Page < PageCount ? "" : "disabled") pager-next">
                    @if (Page < PageCount && UsesButtons)
                    {
                        <button type="button" class="page-link" @onclick="() => OnPage.InvokeAsync(Page + 1)">Next <Icon Name="arrow-right" Size="12" /></button>
                    }
                    else if (Page < PageCount)
                    {
                        <a class="page-link" href="@Href(Page + 1)" data-page-next>Next <Icon Name="arrow-right" Size="12" /></a>
                    }
                    else
                    {
                        <span class="page-link">Next <Icon Name="arrow-right" Size="12" /></span>
                    }
                </li>
            </ul>
            @if (!ShowLatest)
            {
                <span class="pager-latest" aria-hidden="true"></span>
            }
            else if (Page < PageCount)
            {
                <a class="btn btn-sm btn-outline-secondary pager-latest" href="@Href(PageCount)"><Icon Name="arrow-clockwise" Size="12" /> Latest</a>
            }
            else
            {
                <span class="btn btn-sm btn-outline-secondary disabled pager-latest" aria-disabled="true"><Icon Name="arrow-clockwise" Size="12" /> Latest</span>
            }
        </div>
        <p class="text-center text-secondary small mb-0 mt-1">
            Page @Page of @PageCount@if (!UsesButtons)
            {
                <span class="pager-keys"> · ← → to turn pages</span>
            }
        </p>
    </nav>
}

@code {
    [Parameter, EditorRequired]
    public int Page { get; set; }

    [Parameter, EditorRequired]
    public int PageCount { get; set; }

    /// <summary>Knappen Latest till höger, för trådar där sista sidan är den nyaste. Av i trådlistan (B41).</summary>
    [Parameter]
    public bool ShowLatest { get; set; } = true;

    /// <summary>Adressen till en sida. Behövs inte med <see cref="OnPage"/>.</summary>
    [Parameter]
    public Func<int, string> Href { get; set; } = page => "";

    /// <summary>Anropas med sidnumret när sidorna är knappar (B67).</summary>
    [Parameter]
    public EventCallback<int> OnPage { get; set; }

    private bool UsesButtons => OnPage.HasDelegate;

    // Inaktiva steg (Previous på första sidan) visas som text, inte som länk.
    private RenderFragment StepLink(int target, bool enabled, bool prev) =>
        @<text>
            @if (enabled && UsesButtons)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary pager-previous" @onclick="() => OnPage.InvokeAsync(target)"><Icon Name="arrow-left" Size="12" /> Previous</button>
            }
            else if (enabled)
            {
                <a class="btn btn-sm btn-outline-secondary pager-previous" href="@Href(target)" data-page-prev="@(prev ? "" : null)"><Icon Name="arrow-left" Size="12" /> Previous</a>
            }
            else
            {
                <span class="btn btn-sm btn-outline-secondary disabled pager-previous" aria-disabled="true"><Icon Name="arrow-left" Size="12" /> Previous</span>
            }
        </text>;
}
