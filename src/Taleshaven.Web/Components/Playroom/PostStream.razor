@* Inläggen i en tråd (RPG eller OOC) med "Ladda äldre inlägg", liveuppdatering och skrivfält. Kräver interaktiv rendering. *@

@implements IAsyncDisposable

@inject IThreadService ThreadService
@inject IMarkdownRenderer Markdown
@inject PostNotifier Notifier
@inject IJSRuntime JS
@inject ILogger<PostStream> Logger

<section class="post-stream" aria-label="Inlägg">
    @if (hasOlder)
    {
        <div class="text-center mb-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadOlderAsync" disabled="@(loadingOlder || module is null)">
                Ladda äldre inlägg
            </button>
        </div>
    }

    @if (posts.Count == 0)
    {
        <p class="text-secondary">Inga inlägg ännu.@(Thread.CanWrite ? " Skriv det första!" : "")</p>
    }

    @foreach (var post in posts)
    {
        <article @key="post.Item.Id" id="post-@post.Item.Id" class="post card mb-3 @(post.Item.AuthorIsGameMaster ? "post-gm" : "")">
            <div class="card-body">
                <header class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                    <strong>@post.Item.AuthorName</strong>
                    @if (post.Item.AuthorIsGameMaster)
                    {
                        <span class="badge text-bg-dark">GM</span>
                    }
                    <time class="text-secondary small ms-auto" datetime="@post.Item.CreatedAt.ToString("o")">@Dates.DateTime(post.Item.CreatedAt)</time>
                </header>
                <div class="post-content">@post.Html</div>
            </div>
        </article>
    }
</section>

@if (Thread.CanWrite)
{
    <MarkdownEditor MaxLength="ThreadLimits.PostMaxLength" DraftKey="@($"thread-{Thread.Id}")" OnSubmit="SubmitAsync"
                    SubmitText="Skicka inlägg" Label="Nytt inlägg" Placeholder="@Placeholder" />
}
else
{
    <p class="text-secondary fst-italic">
        @(Thread.Status == ThreadStatus.Locked ? "Tråden är låst." : "Du kan läsa men inte skriva här.")
    </p>
}

@code {
    private readonly List<DisplayPost> posts = [];
    private IJSObjectReference? module;
    private string userId = "";
    private bool hasOlder;
    private bool loadingOlder;
    private (string ElementId, double? Top)? anchorBeforePrepend;
    private bool scrollToBottom;

    [Parameter, EditorRequired]
    public ThreadDetails Thread { get; set; } = default!;

    [Parameter]
    public string? Placeholder { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>
    /// De senaste inläggen (plus ett extra som visar om det finns äldre). Förs över från förrenderingen
    /// så att listan inte töms och laddas om när komponenten blir interaktiv.
    /// </summary>
    [PersistentState]
    public List<PostItem>? InitialPosts { get; set; }

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        InitialPosts ??= [.. await ThreadService.GetLatestPostsAsync(Thread.Id, ThreadLimits.PostsPageSize + 1)];
        hasOlder = InitialPosts.Count > ThreadLimits.PostsPageSize;
        posts.AddRange(InitialPosts.Skip(hasOlder ? 1 : 0).Select(ToDisplay));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Körs bara när komponenten är interaktiv (inte vid förrendering).
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Playroom/PostStream.razor.js");
            Notifier.PostCreated += OnPostCreated;

            // Inlägg som skrevs mellan förrenderingen och att kretsen startade.
            Append(await ThreadService.GetPostsAfterAsync(Thread.Id, posts.Count > 0 ? posts[^1].Item.Id : 0));

            scrollToBottom = posts.Count > 0;
            StateHasChanged();
            return;
        }

        if (module is null)
            return;

        if (anchorBeforePrepend is var (elementId, top))
        {
            anchorBeforePrepend = null;
            await module.InvokeVoidAsync("restoreAnchor", elementId, top);
        }

        if (scrollToBottom)
        {
            scrollToBottom = false;
            await module.InvokeVoidAsync("scrollToBottom");
        }
    }

    private async Task LoadOlderAsync()
    {
        if (posts.Count == 0 || module is null)
            return;

        loadingOlder = true;
        try
        {
            var older = await ThreadService.GetPostsBeforeAsync(Thread.Id, posts[0].Item.Id, ThreadLimits.PostsPageSize + 1);
            var more = older.Count > ThreadLimits.PostsPageSize;

            // Äldre inlägg läggs ovanför; det inlägg som var överst ska stå kvar på samma plats på skärmen.
            var anchorId = $"post-{posts[0].Item.Id}";
            anchorBeforePrepend = (anchorId, await module.InvokeAsync<double?>("anchorTop", anchorId));
            posts.InsertRange(0, older.Skip(more ? 1 : 0).Select(ToDisplay));
            hasOlder = more;
        }
        finally
        {
            loadingOlder = false;
        }
    }

    private async Task<string?> SubmitAsync(string content)
    {
        try
        {
            var created = await ThreadService.CreatePostAsync(Thread.CampaignId, Thread.Id, userId, content);
            Append([created]);
            scrollToBottom = true;
            Notifier.NotifyPostCreated(Thread.Id);

            // Anropet kommer från editorn (en Func, inte EventCallback), så den här komponenten renderas inte om automatiskt.
            StateHasChanged();
            return null;
        }
        catch (CampaignRuleException ex)
        {
            return ex.Message;
        }
    }

    private void OnPostCreated(int threadId)
    {
        if (threadId != Thread.Id)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                var lastId = posts.Count > 0 ? posts[^1].Item.Id : 0;
                var newer = await ThreadService.GetPostsAfterAsync(Thread.Id, lastId);
                if (Append(newer))
                    StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Kunde inte hämta nya inlägg för tråd {ThreadId}", Thread.Id);
            }
        });
    }

    // Lägger till inlägg som är nyare än det senaste som visas. Skyddar mot dubbletter vid samtidiga uppdateringar.
    private bool Append(IEnumerable<PostItem> newPosts)
    {
        var added = false;
        foreach (var post in newPosts.OrderBy(p => p.Id))
        {
            if (posts.Count > 0 && post.Id <= posts[^1].Item.Id)
                continue;

            posts.Add(ToDisplay(post));
            added = true;
        }
        return added;
    }

    private DisplayPost ToDisplay(PostItem post) => new(post, (MarkupString)Markdown.ToSafeHtml(post.Content));

    public async ValueTask DisposeAsync()
    {
        Notifier.PostCreated -= OnPostCreated;

        if (module is null)
            return;

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Kretsen är redan nedkopplad.
        }
    }

    private sealed record DisplayPost(PostItem Item, MarkupString Html);
}
