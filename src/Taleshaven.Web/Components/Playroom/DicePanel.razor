@using Taleshaven.Core.Dice

@* Snabbval för tärningar (T-3, B31): välj antal och modifierare och klicka på en tärning. Tärningen läggs in i texten
   som [dice]2d6+3[/dice] och slås först när inlägget publiceras. *@

<div class="dice-panel border rounded p-2 mb-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <label class="small text-secondary" for="dice-count">Number</label>
        <input id="dice-count" type="number" min="1" max="@DiceNotation.MaxCount" class="form-control form-control-sm dice-number" @bind="count" />
        <label class="small text-secondary" for="dice-modifier">Modifier</label>
        <input id="dice-modifier" type="number" min="-@DiceNotation.MaxModifier" max="@DiceNotation.MaxModifier"
               class="form-control form-control-sm dice-number" @bind="modifier" />
    </div>
    <div class="d-flex flex-wrap gap-1 mt-2" role="group" aria-label="Add a die to the post">
        @foreach (var sides in DiceNotation.AllowedSides)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" data-dice="@sides" @onclick="() => InsertAsync(sides)">
                d@(sides)
            </button>
        }
    </div>
    <div class="small text-secondary mt-1">
        The dice are rolled when you post. You can also type <code>[dice]2d6+3[/dice]</code> anywhere in your post.
    </div>
    @if (error is not null)
    {
        <div class="text-danger small mt-1" role="alert">@error</div>
    }
</div>

@code {
    private int count = 1;
    private int modifier;
    private string? error;

    /// <summary>Anropas med taggen som ska läggas in i texten, t.ex. "[dice]2d6+3[/dice]".</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnInsert { get; set; }

    private async Task InsertAsync(int sides)
    {
        error = null;
        try
        {
            var notation = new DiceNotation(count, sides, modifier);
            await OnInsert.InvokeAsync(InlineDice.Tag(notation.ToString()));
        }
        catch (CampaignRuleException ex)
        {
            error = ex.Message;
        }
    }
}
