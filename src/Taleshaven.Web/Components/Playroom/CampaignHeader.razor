@* Kampanjens rubrik och flikar, gemensamt för alla delar av spelrummet. Flikarna RPG och OOC visar antal olästa
   för deltagare; i interaktiva sidor uppdateras antalet när någon skriver. *@

@implements IDisposable

@inject IUnreadService Unread
@inject PostNotifier Notifier

<p class="mb-2 small"><a href="">← Kampanjer</a></p>

<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
    <h1 class="h2 mb-0">@Campaign.Name</h1>
    <CampaignStatusBadge Status="Campaign.Status" />
    @if (CampaignPermissions.CanManageCampaign(Campaign.ViewerRole) && Active != CampaignTab.Settings)
    {
        <a class="btn btn-sm btn-outline-secondary ms-auto" href="campaigns/@(Campaign.Id)/settings">Inställningar</a>
    }
</div>
<p class="text-secondary mb-2">
    GM: @Campaign.GameMasterName
    · @Campaign.Players.Count@(Campaign.MaxPlayers is { } max ? $"/{max}" : "") spelare
</p>

@if (Campaign.Description.Length > 0)
{
    <details class="mb-3">
        <summary class="text-secondary">Om kampanjen</summary>
        <p class="campaign-description mt-2 mb-0">@Campaign.Description</p>
    </details>
}

@if (Campaign.ViewerRole == CampaignRole.None && Active != CampaignTab.Players)
{
    <div class="alert alert-light border d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
        <span>Du deltar inte i kampanjen och kan bara läsa.</span>
        @if (Campaign.CanViewerApply)
        {
            <a class="btn btn-sm btn-primary" href="campaigns/@(Campaign.Id)/players#ansok">Ansök</a>
        }
    </div>
}

<nav>
    <ul class="nav nav-tabs campaign-tabs mb-3">
        @foreach (var (tab, label, path) in Tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(tab == Active ? "active" : "")" aria-current="@(tab == Active ? "page" : null)"
                   href="@($"campaigns/{Campaign.Id}{path}")">
                    @label
                    @* Den aktiva fliken läses just nu, så dess antal visas inte. *@
                    @if (tab != Active && UnreadFor(tab) is > 0 and var count)
                    {
                        <span class="badge rounded-pill text-bg-primary ms-1 unread-count" title="@count olästa">@UnreadDisplay.Format(count)</span>
                    }
                </a>
            </li>
        }
    </ul>
</nav>

@code {
    private static readonly (CampaignTab Tab, string Label, string Path)[] Tabs =
    [
        (CampaignTab.Rpg, "RPG", ""),
        (CampaignTab.Ooc, "OOC", "/ooc"),
        (CampaignTab.Chronicle, "Krönika", "/chronicle"),
        (CampaignTab.Characters, "Karaktärer", "/characters"),
        (CampaignTab.Players, "Spelare", "/players"),
    ];

    [Parameter, EditorRequired]
    public CampaignDetails Campaign { get; set; } = default!;

    [Parameter, EditorRequired]
    public CampaignTab Active { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private UnreadCounts unread = UnreadCounts.None;
    private int unreadLoadedFor;
    private string userId = "";
    private bool subscribed;

    private int UnreadFor(CampaignTab tab) => tab switch
    {
        CampaignTab.Rpg => unread.Rpg,
        CampaignTab.Ooc => unread.Ooc,
        _ => 0,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Campaign.ViewerRole == CampaignRole.None || unreadLoadedFor == Campaign.Id)
            return;

        userId = (await AuthenticationState).User.GetUserId() ?? "";
        unread = await Unread.GetUnreadCountsAsync(Campaign.Id, userId);
        unreadLoadedFor = Campaign.Id;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Körs bara i interaktiva sidor; statiska sidor visar antalet vid sidladdning.
        if (firstRender && Campaign.ViewerRole != CampaignRole.None)
        {
            Notifier.PostCreated += OnPostCreated;
            subscribed = true;
        }
    }

    private void OnPostCreated(int threadId)
    {
        if (!unread.Concerns(threadId))
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                unread = await Unread.GetUnreadCountsAsync(Campaign.Id, userId);
                StateHasChanged();
            }
            catch (Exception)
            {
                // Antalet är bara en hjälp; nästa sidladdning visar rätt värde.
            }
        });
    }

    public void Dispose()
    {
        if (subscribed)
            Notifier.PostCreated -= OnPostCreated;
    }
}
