@* Kampanjens rubrik och flikar (B26), gemensamt för alla delar av spelrummet. Fliken Threads visar antal olästa
   för deltagare; i interaktiva sidor uppdateras antalet när någon skriver. *@

@implements IDisposable

@inject IUnreadService Unread
@inject PostNotifier Notifier

<p class="mb-2 small"><a href="">← Campaigns</a></p>

<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
    <h1 class="h2 mb-0">@Campaign.Name</h1>
    <CampaignStatusBadge Status="Campaign.Status" />
    @if (CampaignPermissions.CanManageCampaign(Campaign.ViewerRole) && Active != CampaignTab.Settings)
    {
        <a class="btn btn-sm btn-outline-secondary ms-auto" href="campaigns/@(Campaign.Id)/settings">Settings</a>
    }
</div>
<p class="text-secondary mb-2">
    GM: @Campaign.GameMasterName
    · @Campaign.Players.Count@(Campaign.MaxPlayers is { } max ? $"/{max}" : "") players
    @foreach (var tag in Campaign.Tags)
    {
        <a class="campaign-tag ms-1" href="@($"?q={Uri.EscapeDataString(tag)}")">#@tag</a>
    }
</p>

@if (Campaign.Description.Length > 0)
{
    <details class="mb-3">
        <summary class="text-secondary">About the campaign</summary>
        <p class="campaign-description mt-2 mb-0">@Campaign.Description</p>
    </details>
}

@if (Campaign.ViewerRole == CampaignRole.None && Active != CampaignTab.Players)
{
    <div class="alert alert-light border d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
        <span>You are not in this campaign and can only read.</span>
        @if (Campaign.CanViewerApply)
        {
            <a class="btn btn-sm btn-primary" href="campaigns/@(Campaign.Id)/players#apply">Apply</a>
        }
    </div>
}

<nav>
    <ul class="nav nav-tabs campaign-tabs mb-3">
        @foreach (var (tab, label, path) in Tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(tab == Active ? "active" : "")" aria-current="@(tab == Active ? "page" : null)"
                   href="@($"campaigns/{Campaign.Id}{path}")">
                    @label
                    @if (tab == CampaignTab.Threads && unread is > 0 and var count)
                    {
                        <span class="badge rounded-pill text-bg-primary ms-1 unread-count" title="@count unread">@UnreadDisplay.Format(count)</span>
                    }
                </a>
            </li>
        }
    </ul>
</nav>

@code {
    private static readonly (CampaignTab Tab, string Label, string Path)[] Tabs =
    [
        (CampaignTab.Threads, "Threads", ""),
        (CampaignTab.Characters, "Characters", "/characters"),
        (CampaignTab.Players, "Players", "/players"),
    ];

    [Parameter, EditorRequired]
    public CampaignDetails Campaign { get; set; } = default!;

    [Parameter, EditorRequired]
    public CampaignTab Active { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private int unread;
    private int unreadLoadedFor;
    private string userId = "";
    private bool subscribed;


    protected override async Task OnParametersSetAsync()
    {
        if (Campaign.ViewerRole == CampaignRole.None || unreadLoadedFor == Campaign.Id)
            return;

        userId = (await AuthenticationState).User.GetUserId() ?? "";
        unread = await CountUnreadAsync();
        unreadLoadedFor = Campaign.Id;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Körs bara i interaktiva sidor; statiska sidor visar antalet vid sidladdning.
        if (firstRender && Campaign.ViewerRole != CampaignRole.None)
        {
            Notifier.PostCreated += OnPostCreated;
            subscribed = true;
        }
    }

    private async Task<int> CountUnreadAsync() => (await Unread.GetThreadUnreadAsync(Campaign.Id, userId)).Values.Sum();

    /// <summary>Räknar om olästa, t.ex. när trådsidan har markerat inlägg som lästa.</summary>
    public async Task RefreshUnreadAsync()
    {
        if (Campaign.ViewerRole == CampaignRole.None)
            return;

        unread = await CountUnreadAsync();
        StateHasChanged();
    }

    private void OnPostCreated(int campaignId, int threadId)
    {
        if (campaignId != Campaign.Id)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                unread = await CountUnreadAsync();
                StateHasChanged();
            }
            catch (Exception)
            {
                // Antalet är bara en hjälp; nästa sidladdning visar rätt värde.
            }
        });
    }

    public void Dispose()
    {
        if (subscribed)
            Notifier.PostCreated -= OnPostCreated;
    }
}
