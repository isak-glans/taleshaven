@page "/portraits"
@attribute [Authorize]
@rendermode InteractiveServer

@using Taleshaven.Core.Media
@using Taleshaven.Core.Portraits
@using Taleshaven.Core.Site

@* Bildbiblioteket (B19, PB-1–PB-3). Administratörer och managers laddar upp, taggar och tar bort porträtt och ikoner;
   typen (B61) väljs vid uppladdning och kan ändras. *@

@inject IPortraitService Portraits
@inject ISiteRoleService RoleService
@inject IImageProcessor ImageProcessor
@inject NavigationManager NavigationManager

@if (!loaded)
{
    return;
}

<PageTitle>Image library</PageTitle>

<h1 class="h3 mb-1">Image library</h1>
<p class="text-secondary">
    Portraits can be chosen for any character, NPC or profile on the site. Icons are shown on counters, conditions and dice rolls.
</p>

<section class="card card-body mb-4 portrait-upload">
    <h2 class="h6">Add an image</h2>
    <div class="d-flex flex-wrap gap-3">
        @if (preview is not null)
        {
            <img class="portrait-preview" src="@preview" alt="Preview" width="128" height="128" />
        }
        <div class="flex-grow-1 d-flex flex-column gap-2">
            <div>
                <label for="portrait-file" class="form-label small mb-1">Image</label>
                <InputFile id="portrait-file" @key="fileInputKey" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp" OnChange="OnImageSelectedAsync" />
                <div class="form-text">JPG, PNG or WebP, at most 5 MB. The image is cropped to a square.</div>
            </div>
            <fieldset>
                <legend class="form-label small mb-1">Type</legend>
                <div class="btn-group btn-group-sm image-kind" role="radiogroup" aria-label="Type">
                    @foreach (var kind in Kinds)
                    {
                        <input type="radio" class="btn-check" name="new-kind" id="new-kind-@kind" checked="@(newKind == kind)"
                               @onchange="() => SetNewKindAsync(kind)" />
                        <label class="btn btn-outline-secondary" for="new-kind-@kind">@KindName(kind)</label>
                    }
                </div>
                <div class="form-text">@(newKind == ImageKind.Icon ? "Small pictures for counters, conditions and dice rolls; never shown as portraits." : "For characters, NPCs and profiles.")</div>
            </fieldset>
            <div>
                <label for="portrait-tags" class="form-label small mb-1">Tags</label>
                <input id="portrait-tags" class="form-control form-control-sm" placeholder="#dwarf #warrior" @bind="newTags" @bind:event="oninput" />
                <TagSuggestions Tags="tags" Current="@newTags" OnPick="tag => newTags = AppendTag(newTags, tag)" />
            </div>
            <div>
                <label for="portrait-source" class="form-label small mb-1">Source and licence <span class="text-secondary">(optional)</span></label>
                <input id="portrait-source" class="form-control form-control-sm" maxlength="@PortraitTags.SourceMaxLength"
                       placeholder="E.g. Own image, CC BY 4.0" @bind="newSource" />
            </div>
            <div>
                <button type="button" class="btn btn-primary btn-sm" disabled="@(image is null || busy)" @onclick="UploadAsync">Add to library</button>
            </div>
            @if (uploadError is not null)
            {
                <div class="text-danger small" role="alert">@uploadError</div>
            }
            @if (uploadStatus is not null)
            {
                <div class="text-success small" role="status">@uploadStatus</div>
            }
        </div>
    </div>
</section>

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h2 class="h5 mb-0 me-auto">Library</h2>
    <div class="btn-group btn-group-sm library-filter" role="group" aria-label="Show">
        <button type="button" class="btn @(filterKind is null ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@(filterKind is null ? "true" : "false")"
                @onclick="() => SetFilterAsync(null)">All</button>
        @foreach (var kind in Kinds)
        {
            <button type="button" class="btn @(filterKind == kind ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@(filterKind == kind ? "true" : "false")"
                    @onclick="() => SetFilterAsync(kind)">@(KindName(kind))s</button>
        }
    </div>
    <input type="search" class="form-control form-control-sm w-auto" placeholder="Search tags" aria-label="Search portraits by tag"
           @bind="query" @bind:event="oninput" @bind:after="OnQueryChangedAsync" />
</div>

@if (page is { Portraits.Count: 0 })
{
    <p class="text-secondary">@(string.IsNullOrWhiteSpace(query) ? "The library is empty." : "No images have those tags.")</p>
}
else if (page is not null)
{
    <div class="portrait-cards">
        @foreach (var portrait in page.Portraits)
        {
            <article class="card portrait-card" data-portrait-id="@portrait.Id">
                <img src="@portrait.Url" alt="@PortraitTags.Format(portrait.Tags)" class="card-img-top" loading="lazy" />
                <div class="card-body p-2 small">
                    @if (editingId == portrait.Id)
                    {
                        <label class="form-label small mb-1" for="edit-kind-@portrait.Id">Type</label>
                        <select id="edit-kind-@portrait.Id" class="form-select form-select-sm mb-1 edit-kind" @bind="editKind">
                            @foreach (var kind in Kinds)
                            {
                                <option value="@kind">@KindName(kind)</option>
                            }
                        </select>
                        <label class="form-label small mb-1" for="edit-tags-@portrait.Id">Tags</label>
                        <input id="edit-tags-@portrait.Id" class="form-control form-control-sm mb-1 edit-tags" @bind="editTags" @bind:event="oninput" />
                        <label class="form-label small mb-1" for="edit-source-@portrait.Id">Source and licence</label>
                        <input id="edit-source-@portrait.Id" class="form-control form-control-sm mb-2" maxlength="@PortraitTags.SourceMaxLength" @bind="editSource" />
                        @if (editError is not null)
                        {
                            <div class="text-danger mb-1" role="alert">@editError</div>
                        }
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveEditAsync">Save</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => editingId = null">Cancel</button>
                        </div>
                    }
                    else
                    {
                        @if (portrait.Kind == ImageKind.Icon)
                        {
                            <span class="badge text-bg-secondary image-kind-badge">Icon</span>
                        }
                        <div class="portrait-card-tags">@PortraitTags.Format(portrait.Tags)</div>
                        @if (portrait.Source is not null)
                        {
                            <div class="text-secondary portrait-card-source">@portrait.Source</div>
                        }
                        <div class="text-secondary">@UsageText(portrait.UsageCount)</div>

                        @if (deletingId == portrait.Id)
                        {
                            <div class="mt-2" role="alert">
                                Delete the portrait?
                                @if (portrait.UsageCount > 0)
                                {
                                    <text> @UsageText(portrait.UsageCount) and will get initials instead.</text>
                                }
                            </div>
                            <div class="d-flex gap-1 mt-1">
                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(portrait.Id)">Yes, delete</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => deletingId = null">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-1 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(portrait)">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => { deletingId = portrait.Id; editingId = null; }">Delete</button>
                            </div>
                        }
                    }
                </div>
            </article>
        }
    </div>
    @if (page.HasMore)
    {
        <button type="button" class="btn btn-link px-0 mt-2" @onclick="ShowMoreAsync">Show more</button>
    }
}

@code {
    private const int PageSize = 48;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string userId = "";
    private bool loaded;
    private PortraitPage? page;
    private IReadOnlyList<TagCount> tags = [];
    private string query = "";
    private int limit = PageSize;
    private int searchVersion;
    private ImageKind? filterKind;

    private static readonly ImageKind[] Kinds = Enum.GetValues<ImageKind>();
    private ImageKind newKind = ImageKind.Portrait;

    private byte[]? image;
    private string? preview;
    private string? newTags;
    private string? newSource;
    private string? uploadError;
    private string? uploadStatus;
    private bool busy;
    private int fileInputKey;

    private int? editingId;
    private ImageKind editKind;
    private string? editTags;
    private string? editSource;
    private string? editError;
    private int? deletingId;

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        if (!SitePermissions.CanManagePortraits(await RoleService.GetRolesAsync(userId)))
        {
            NavigationManager.NotFound();
            return;
        }

        await RefreshAsync();
        loaded = true;
    }

    private async Task RefreshAsync()
    {
        tags = await Portraits.GetTagsAsync(newKind);
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var version = ++searchVersion;
        var result = await Portraits.SearchAsync(query, limit, kind: filterKind);
        if (version == searchVersion)
            page = result;
    }

    private async Task OnQueryChangedAsync()
    {
        limit = PageSize;
        await SearchAsync();
    }

    private async Task SetFilterAsync(ImageKind? kind)
    {
        filterKind = kind;
        limit = PageSize;
        await SearchAsync();
    }

    // Taggförslagen gäller den typ som laddas upp.
    private async Task SetNewKindAsync(ImageKind kind)
    {
        newKind = kind;
        tags = await Portraits.GetTagsAsync(newKind);
    }

    private static string KindName(ImageKind kind) => kind switch
    {
        ImageKind.Icon => "Icon",
        _ => "Portrait",
    };

    private async Task ShowMoreAsync()
    {
        limit += PageSize;
        await SearchAsync();
    }

    // Bilden behandlas direkt när den väljs, så att förhandsvisningen visar exakt det som sparas.
    private async Task OnImageSelectedAsync(InputFileChangeEventArgs e)
    {
        uploadError = null;
        uploadStatus = null;
        image = null;
        preview = null;
        if (e.File.Size > ImageLimits.MaxUploadBytes)
        {
            uploadError = "The image can be at most 5 MB.";
            return;
        }

        try
        {
            await using var upload = e.File.OpenReadStream(ImageLimits.MaxUploadBytes);
            using var buffer = new MemoryStream();
            await upload.CopyToAsync(buffer);
            buffer.Position = 0;

            image = ImageProcessor.CreatePortrait(buffer);
            preview = $"data:{IImageStore.PortraitContentType};base64,{Convert.ToBase64String(image)}";
        }
        catch (CampaignRuleException ex)
        {
            uploadError = ex.Message;
        }
        catch (IOException)
        {
            uploadError = "The image couldn't be read.";
        }
    }

    private async Task UploadAsync()
    {
        if (image is null)
            return;

        busy = true;
        uploadError = null;
        try
        {
            await Portraits.UploadAsync(userId, newKind, image, newTags, newSource);
        }
        catch (CampaignRuleException ex)
        {
            uploadError = ex.Message;
            return;
        }
        finally
        {
            busy = false;
        }

        // Taggarna står kvar, så att en serie bilder med samma taggar går snabbt att lägga till.
        image = null;
        preview = null;
        fileInputKey++;
        uploadStatus = newKind == ImageKind.Icon ? "The icon has been added." : "The portrait has been added.";
        await RefreshAsync();
    }

    private void StartEdit(PortraitView portrait)
    {
        editingId = portrait.Id;
        editKind = portrait.Kind;
        editTags = PortraitTags.Format(portrait.Tags);
        editSource = portrait.Source;
        editError = null;
        deletingId = null;
    }

    private async Task SaveEditAsync()
    {
        if (editingId is not { } id)
            return;

        try
        {
            await Portraits.UpdateAsync(userId, id, editKind, editTags, editSource);
        }
        catch (CampaignRuleException ex)
        {
            editError = ex.Message;
            return;
        }

        editingId = null;
        await RefreshAsync();
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            await Portraits.DeleteAsync(userId, id);
        }
        catch (CampaignRuleException ex)
        {
            uploadError = ex.Message;
        }

        deletingId = null;
        await RefreshAsync();
    }

    private static string UsageText(int count) => count switch
    {
        0 => "Not used",
        1 => "Used by 1 character",
        _ => $"Used by {count} characters",
    };

    // Ett påbörjat ord ("#dv") ersätts av den valda taggen.
    private static string AppendTag(string? current, string tag)
    {
        var existing = PortraitTags.ParseSearch(current).ToList();
        if (current is { Length: > 0 } && !char.IsWhiteSpace(current[^1]) && existing.Count > 0)
            existing.RemoveAt(existing.Count - 1);
        if (!existing.Contains(tag))
            existing.Add(tag);
        return PortraitTags.Format(existing) + " ";
    }
}
