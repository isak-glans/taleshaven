@page "/"

@inject ICampaignService CampaignService
@inject IUnreadService Unread

<PageTitle>Taleshaven</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="mb-0">Kampanjer</h1>
            <a class="btn btn-primary" href="campaigns/new">Skapa kampanj</a>
        </div>

        @if (campaigns is null)
        {
            <p>Laddar…</p>
        }
        else if (campaigns.Count == 0)
        {
            <p>Det finns inga kampanjer än. Bli den första att <a href="campaigns/new">skapa en</a>!</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var campaign in campaigns)
                {
                    <li class="list-group-item py-3">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="campaign-summary">
                                <h2 class="h5 mb-1">
                                    <a href="campaigns/@campaign.Id">@campaign.Name</a>
                                    @if (unreadTotals.TryGetValue(campaign.Id, out var unreadCount))
                                    {
                                        <span class="badge rounded-pill text-bg-primary align-middle ms-1 unread-count">@UnreadDisplay.Format(unreadCount) nya</span>
                                    }
                                </h2>
                                <div class="text-secondary small mb-1">
                                    GM: @campaign.GameMasterName
                                    · @campaign.PlayerCount@(campaign.MaxPlayers is { } max ? $"/{max}" : "") spelare
                                </div>
                                @if (campaign.Description.Length > 0)
                                {
                                    <p class="mb-0 campaign-description">@campaign.Description</p>
                                }
                            </div>
                            <div class="text-end flex-shrink-0">
                                <CampaignStatusBadge Status="campaign.Status" />
                                <div class="small text-secondary mt-1">
                                    @if (campaign.ViewerRole == CampaignRole.GameMaster)
                                    {
                                        <span>Du är GM</span>
                                    }
                                    else if (campaign.ViewerRole == CampaignRole.Player)
                                    {
                                        <span>Du deltar</span>
                                    }
                                    else if (campaign.ViewerHasPendingApplication)
                                    {
                                        <span>Ansökan skickad</span>
                                    }
                                    else if (campaign.CanViewerApply)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="campaigns/@(campaign.Id)/players#ansok">Ansök</a>
                                    }
                                    else if (campaign.Status == CampaignStatus.OpenForApplications && !campaign.AcceptsApplications)
                                    {
                                        <span>Fullt</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </Authorized>
    <NotAuthorized>
        <h1>Välkommen till Taleshaven</h1>
        <p class="lead">En plats för rollspel i play-by-post-format, oavsett regelsystem.</p>
        <p>
            <a class="btn btn-primary" href="Account/Login">Logga in</a>
            <a class="btn btn-outline-primary ms-2" href="Account/Register">Skapa konto</a>
        </p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private IReadOnlyList<CampaignListItem>? campaigns;
    private IReadOnlyDictionary<int, int> unreadTotals = new Dictionary<int, int>();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        if (user.GetUserId() is { } userId)
        {
            campaigns = await CampaignService.GetCampaignsAsync(userId);
            unreadTotals = await Unread.GetUnreadTotalsAsync(userId);
        }
    }
}
