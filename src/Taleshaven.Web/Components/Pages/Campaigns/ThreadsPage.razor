@page "/campaigns/{CampaignId:int}"
@attribute [Authorize]

@* Kampanjens startsida: trådarna (B26, B27, B37, B41). Kompakta textrader utan bilder. Ett filter visar aktiva eller
   avslutade trådar, 20 per sida, i GM:s ordning. *@

@inject ICampaignService CampaignService
@inject IThreadService ThreadService
@inject NavigationManager NavigationManager

@if (campaign is null || threads is null)
{
    return;
}

<PageTitle>@campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="CampaignTab.Threads" />

@if (errorMessage is not null)
{
    <div class="alert alert-danger py-2" role="alert">@errorMessage</div>
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <nav class="nav nav-pills thread-filter" aria-label="Thread status">
        @FilterLink(ThreadStatus.Active, "Active")
        @FilterLink(ThreadStatus.Completed, "Completed")
    </nav>
    @if (canManage)
    {
        <a class="btn btn-primary btn-sm ms-auto" href="@ThreadLinks.New(CampaignId)">+ New thread</a>
    }
</div>

@if (threads.Count == 0)
{
    <p class="text-secondary">
        No threads yet.@(canManage ? " Create a thread for the first scene, and perhaps one for out-of-character talk." : " The GM hasn't started any threads.")
    </p>
}
else if (shown.Count == 0)
{
    <p class="text-secondary thread-filter-empty">
        @if (Status == ThreadStatus.Active)
        {
            <text>No active threads. </text><a href="@ThreadLinks.Threads(CampaignId, ThreadStatus.Completed)">See the completed threads</a>
        }
        else
        {
            <text>No completed threads yet.</text>
        }
    </p>
}
else
{
    <ul class="list-group mb-3 thread-list">
        @for (var i = 0; i < shown.Count; i++)
        {
            var thread = shown[i];
            var position = firstIndex + i;
            <li class="list-group-item thread-row @(thread.UnreadCount > 0 ? "has-unread" : "")" data-thread-id="@thread.Id">
                <div class="d-flex flex-wrap align-items-baseline gap-2">
                    @if (thread.UnreadCount > 0)
                    {
                        <span class="unread-dot" aria-hidden="true">●</span>
                    }
                    <a class="thread-title fw-semibold" href="@ThreadLinks.Thread(CampaignId, thread.Id)">@thread.Title</a>
                    @if (thread.Status == ThreadStatus.Completed)
                    {
                        <span class="badge rounded-pill text-bg-light border thread-status">Completed</span>
                    }
                    @if (thread.UnreadCount > 0)
                    {
                        <a class="badge rounded-pill text-bg-danger unread-count" href="@ThreadLinks.Thread(CampaignId, thread.Id)">
                            @UnreadDisplay.Format(thread.UnreadCount) new @(thread.UnreadCount == 1 ? "post" : "posts")
                        </a>
                    }
                    @if (canManage)
                    {
                        @* Ordningen styrs av GM (B27). Statisk sida, så varje knapp är ett eget formulär. *@
                        <form method="post" @formname="@($"move-{thread.Id}")" @onsubmit="MoveAsync" class="ms-auto d-flex gap-1">
                            <AntiforgeryToken />
                            <input type="hidden" name="Move.ThreadId" value="@thread.Id" />
                            <button type="submit" name="Move.Direction" value="-1" class="btn btn-sm btn-outline-secondary py-0"
                                    title="Move up" aria-label="Move @thread.Title up" disabled="@(position == 0)">↑</button>
                            <button type="submit" name="Move.Direction" value="1" class="btn btn-sm btn-outline-secondary py-0"
                                    title="Move down" aria-label="Move @thread.Title down" disabled="@(position == filtered.Count - 1)">↓</button>
                        </form>
                    }
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 small text-secondary mt-1 thread-meta">
                    <span>@thread.PostCount @(thread.PostCount == 1 ? "post" : "posts") · @thread.ParticipantCount @(thread.ParticipantCount == 1 ? "participant" : "participants")</span>
                    @if (thread.LastPostAuthor is { } author && thread.LastPostAt is { } at)
                    {
                        <span class="ms-sm-auto d-flex align-items-center gap-1 thread-last">
                            Latest:
                            <Avatar Name="@author.Name" ImageUrl="@author.AvatarUrl" ColorKey="@author.ColorKey" Silhouette="author.IsHiddenNpc" Size="18" />
                            <span class="thread-last-name">@author.Name</span>
                            · <time datetime="@at.ToString("o")" title="@Dates.DateTime(at)">@Dates.Relative(at, now)</time>
                        </span>
                    }
                </div>
            </li>
        }
    </ul>

    <Pager Page="pageNumber" PageCount="pageCount" ShowLatest="false" Href="@(p => ThreadLinks.Threads(CampaignId, Status, p))" />
}

@code {
    [Parameter]
    public int CampaignId { get; set; }

    /// <summary>"completed" visar de avslutade trådarna; annars visas de aktiva (B41).</summary>
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    // Binds från GM:ns flytta-formulär.
    [SupplyParameterFromForm]
    private MoveModel? Move { get; set; }

    private string userId = "";
    private CampaignDetails? campaign;
    private IReadOnlyList<ThreadSummary>? threads;
    private List<ThreadSummary> filtered = [];
    private List<ThreadSummary> shown = [];
    private int pageNumber = 1;
    private int pageCount = 1;
    private int firstIndex;
    private bool canManage;
    private string? errorMessage;
    private DateTimeOffset now;

    private ThreadStatus Status => string.Equals(StatusQuery, "completed", StringComparison.OrdinalIgnoreCase)
        ? ThreadStatus.Completed
        : ThreadStatus.Active;

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";
        now = DateTimeOffset.UtcNow;

        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign is null)
        {
            NavigationManager.NotFound();
            return;
        }

        canManage = CampaignPermissions.CanManageThreads(campaign.ViewerRole);
        threads = await ThreadService.GetThreadsAsync(CampaignId, userId);

        filtered = [.. threads.Where(t => t.Status == Status)];
        pageCount = Paging.PageCount(filtered.Count, ThreadLimits.ThreadsPerPage);
        pageNumber = Paging.Clamp(PageQuery ?? 1, pageCount);
        firstIndex = (pageNumber - 1) * ThreadLimits.ThreadsPerPage;
        shown = [.. filtered.Skip(firstIndex).Take(ThreadLimits.ThreadsPerPage)];
    }

    // Filtret visar antalet trådar och hur många olästa inlägg som finns bland dem, så att inget missas i det andra filtret.
    private RenderFragment FilterLink(ThreadStatus status, string text)
    {
        var count = threads!.Count(t => t.Status == status);
        var unread = threads!.Where(t => t.Status == status).Sum(t => t.UnreadCount);
        var current = status == Status;
        return @<a class="nav-link py-1 px-3 @(current ? "active" : "")" href="@ThreadLinks.Threads(CampaignId, status)"
                   aria-current="@(current ? "page" : null)" data-filter="@status.ToString().ToLowerInvariant()">
            @text <span class="thread-filter-count">@count</span>
            @if (unread > 0)
            {
                <span class="badge rounded-pill text-bg-danger ms-1 thread-filter-unread">@UnreadDisplay.Format(unread) new</span>
            }
        </a>;
    }

    private async Task MoveAsync()
    {
        if (Move is not { ThreadId: { } threadId, Direction: -1 or 1 })
            return;

        try
        {
            await ThreadService.MoveThreadAsync(CampaignId, threadId, userId, Move.Direction.Value);
        }
        catch (CampaignRuleException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        NavigationManager.NavigateTo(ThreadLinks.Threads(CampaignId, Status, pageNumber));
    }

    private sealed class MoveModel
    {
        public int? ThreadId { get; set; }
        public int? Direction { get; set; }
    }
}
