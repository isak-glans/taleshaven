@page "/campaigns/{CampaignId:int}/threads/{ThreadId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Taleshaven.Core.Characters
@using Taleshaven.Core.Dice
@using System.Text.Json
@using System.Text.Json.Serialization

@* En tråd (B28–B37): inläggen 20 per sida med sidnavigering längst ner och skrivfältet under sista sidan. Ingen automatisk scroll: sidan hoppar bara till ett inlägg som man bett om
   (fast länk eller första olästa). Nya inlägg läggs till direkt bara för den som står på sista sidan. *@

@inject ICampaignService CampaignService
@inject IThreadService ThreadService
@inject ICharacterService CharacterService
@inject IUnreadService Unread
@inject IMarkdownRenderer Markdown
@inject PostNotifier Notifier
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<ThreadPage> Logger

@if (campaign is null || thread is null || page is null)
{
    return;
}

<PageTitle>@thread.Title · @campaign.Name</PageTitle>

<CampaignHeader @ref="header" Campaign="campaign" Active="CampaignTab.Threads" />

<div class="thread-head mb-3">
    <p class="small mb-1"><a href="@ThreadLinks.Threads(CampaignId)">← Threads</a></p>
    <div class="d-flex flex-wrap align-items-start gap-2">
        <div class="d-flex flex-wrap align-items-center gap-2 me-auto">
            <h2 class="h4 mb-0 thread-title">@thread.Title</h2>
            <span class="badge rounded-pill @(thread.Status == ThreadStatus.Active ? "text-bg-success" : "text-bg-light border") thread-status">@(thread.Status == ThreadStatus.Active ? "Active" : "Completed")</span>
        </div>
        @if (thread.CanManage)
        {
            @* Trådens åtgärder ligger i "…"-menyn längst till höger (B39). *@
            <div class="d-flex gap-2 thread-actions">
                <div class="menu-anchor">
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="More" aria-label="More thread actions"
                            aria-expanded="@(openMenu == "thread" ? "true" : "false")" @onclick="@(() => ToggleMenu("thread"))">
                        <Icon Name="three-dots" />
                    </button>
                    @if (openMenu == "thread")
                    {
                        <div class="menu-backdrop" @onclick="CloseMenu"></div>
                        <div class="action-menu border rounded shadow-sm" role="menu">
                            @if (thread.Status == ThreadStatus.Active)
                            {
                                <button type="button" class="action-menu-item thread-complete" role="menuitem"
                                        @onclick="() => { confirmComplete = true; openMenu = null; }"><Icon Name="check-circle" /> Complete thread</button>
                            }
                            <a class="action-menu-item" role="menuitem" href="@ThreadLinks.Edit(CampaignId, ThreadId)"><Icon Name="pencil" /> Rename thread</a>
                            @if (thread.Status == ThreadStatus.Completed)
                            {
                                <button type="button" class="action-menu-item" role="menuitem" @onclick="ReopenAsync"><Icon Name="arrow-clockwise" /> Reopen</button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <div class="d-flex flex-wrap align-items-center gap-3 small text-secondary mt-2 thread-meta">
        <span><Icon Name="chat" /> @thread.PostCount @(thread.PostCount == 1 ? "post" : "posts")</span>
        <span><Icon Name="people" /> @thread.ParticipantCount @(thread.ParticipantCount == 1 ? "participant" : "participants")</span>
        @if (firstUnreadId is { } unreadId)
        {
            <a href="@ThreadLinks.Post(CampaignId, ThreadId, unreadId)">First unread</a>
        }
        <a href="@ThreadLinks.Latest(CampaignId, ThreadId)">Latest</a>
    </div>
    @if (thread.CanManage && thread.Status == ThreadStatus.Active && confirmComplete)
    {
        <div class="alert alert-warning py-2 mt-2 mb-0 d-flex flex-wrap align-items-center gap-2 thread-confirm-complete" role="alert">
            Complete this thread? Players can no longer post in it.
            <button type="button" class="btn btn-sm btn-success py-0" @onclick="CompleteAsync">Yes, complete</button>
            <button type="button" class="btn btn-sm btn-link py-0" @onclick="() => confirmComplete = false">Cancel</button>
        </div>
    }
    @if (actionError is not null)
    {
        <div class="alert alert-danger py-2 mt-2 mb-0" role="alert">@actionError</div>
    }
</div>

@if (page.TotalCount == 0)
{
    <p class="text-secondary py-3">No posts yet.@(thread.CanWrite ? " Write the first one!" : "")</p>
}

<div class="thread-posts">
    @foreach (var post in posts)
    {
        <div @key="post.Id">
            @if (post.Id == firstUnreadId)
            {
                <div class="thread-unread" id="first-unread" role="separator"><span>New posts</span></div>
            }
            @PostView(post)
        </div>
    }
</div>

@if (newPostsElsewhere > 0)
{
    <div class="alert alert-info py-2 d-flex flex-wrap align-items-center gap-2 new-posts-banner" role="status">
        @newPostsElsewhere new @(newPostsElsewhere == 1 ? "post" : "posts")
        <a href="@ThreadLinks.Latest(CampaignId, ThreadId)">– go to latest</a>
    </div>
}

<Pager Page="page.Page" PageCount="page.PageCount" Href="@(p => ThreadLinks.Page(CampaignId, ThreadId, p))" />

<div class="thread-composer mt-3" id="composer">
    @if (!thread.CanWrite)
    {
        <p class="text-secondary fst-italic mb-0">
            @(thread.Status == ThreadStatus.Completed ? "This thread is completed." : "You can read but not post here.")
        </p>
    }
    else if (!OnLastPage)
    {
        <p class="text-secondary mb-0"><a href="@ThreadLinks.Latest(CampaignId, ThreadId)">Go to the latest page</a> to post.</p>
    }
    else
    {
        @if (replyTo is { } reply)
        {
            <div class="small text-secondary mb-1 reply-indicator">
                ↪ Replying to <a href="@ThreadLinks.Post(CampaignId, ThreadId, reply.PostId)">@reply.Name</a>
                <button type="button" class="btn btn-link btn-sm p-0 ms-1" aria-label="Cancel reply" @onclick="() => replyTo = null">✕</button>
            </div>
        }
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            @if (postingOptions.Count > 0)
            {
                <label for="post-as" class="small text-secondary">Post as</label>
                <CharacterPicker Id="post-as" Options="postingOptions" @bind-Value="selectedCharacterId"
                                 NoneLabel="@(campaign.ViewerRole == CampaignRole.GameMaster ? "GM (narrator)" : "Myself, no character")"
                                 NoneFirst="campaign.ViewerRole == CampaignRole.GameMaster" />
            }
            else if (campaign.ViewerRole == CampaignRole.Player)
            {
                <span class="small text-secondary">
                    Create a character under <a href="campaigns/@CampaignId/characters">Characters</a> to post as it.
                </span>
            }
        </div>
        <MarkdownEditor @ref="composer" MaxLength="ThreadLimits.PostMaxLength" DraftKey="@($"thread-{ThreadId}")" OnSubmit="SubmitAsync"
                        SubmitText="Post" Label="New post" Placeholder="Write your post…" Rows="5" ShowOocButton="true" ShowSpoilerButton="true"
                        AllowEmpty="@(rollRows.Count > 0)" RenderPreview="@(text => PostHtml.Preview(Markdown, text, PendingRolls()))">
            <BelowText>
                @* Tärningsslagen läggs till som rader och slås när inlägget publiceras (B42). *@
                <div class="roll-editor mt-2">
                    @foreach (var row in rollRows)
                    {
                        <div class="roll-row" @key="row">
                            <span class="roll-row-icon" aria-hidden="true">🎲</span>
                            <input class="form-control form-control-sm roll-notation @(row.Error is null ? "" : "is-invalid")" placeholder="1d20+5"
                                   maxlength="12" aria-label="Dice, e.g. 1d20+5" value="@row.Notation" @oninput="e => SetNotationAsync(row, e.Value as string)" @onchange="() => row.Validate()" />
                            <input class="form-control form-control-sm roll-label" placeholder="What is it for? (optional)" maxlength="@DiceRoll.LabelMaxLength"
                                   aria-label="Description of the roll" value="@row.Label" @oninput="e => SetLabelAsync(row, e.Value as string)" />
                            <select class="form-select form-select-sm roll-mode" aria-label="Advantage or disadvantage" disabled="@(!row.SupportsMode)"
                                    title="@(row.SupportsMode ? "Roll two d20 and keep the higher or lower" : "Advantage and disadvantage work with a single d20")"
                                    value="@row.Mode" @onchange="e => SetModeAsync(row, e.Value as string)">
                                <option value="@DiceMode.Normal">Normal</option>
                                <option value="@DiceMode.Advantage">Advantage</option>
                                <option value="@DiceMode.Disadvantage">Disadvantage</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-link text-secondary roll-remove" title="Remove roll" aria-label="Remove roll"
                                    @onclick="() => RemoveRollAsync(row)">✕</button>
                            @if (row.Error is not null)
                            {
                                <div class="small text-danger roll-error">@row.Error</div>
                            }
                        </div>
                    }
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @if (rollRows.Count < ThreadLimits.MaxRollsPerPost)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary roll-add" @onclick="AddRollAsync">🎲 Add roll</button>
                        }
                        @if (rollRows.Count > 0)
                        {
                            <small class="text-secondary">The dice are rolled when you post.</small>
                        }
                    </div>
                </div>
            </BelowText>
        </MarkdownEditor>
    }
</div>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [Parameter]
    public int ThreadId { get; set; }

    /// <summary>Sidnummer, eller "last" för sista sidan.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageQuery { get; set; }

    /// <summary>Fast länk till ett inlägg (B30).</summary>
    [SupplyParameterFromQuery(Name = "post")]
    public long? PostQuery { get; set; }

    /// <summary>Svar eller citat som påbörjades på en tidigare sida.</summary>
    [SupplyParameterFromQuery(Name = "reply")]
    public long? ReplyQuery { get; set; }

    [SupplyParameterFromQuery(Name = "quote")]
    public long? QuoteQuery { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string userId = "";
    private CampaignDetails? campaign;
    private ThreadDetails? thread;
    private PostPage? page;
    private readonly List<PostItem> posts = [];
    private List<CharacterOption> postingOptions = [];
    private int? selectedCharacterId;
    private long? firstUnreadId;
    private PostReference? replyTo;
    private long? editingPostId;
    private long? confirmDeleteId;
    private bool confirmComplete;
    private int? postingLoadedFor;
    private string? openMenu;
    private long? copiedPostId;
    private DateTimeOffset now = DateTimeOffset.UtcNow;
    private string? actionError;
    private int newPostsElsewhere;
    private string? scrollTarget;
    private bool scrollToTop;
    private long? pendingQuote;
    private long markedReadUpTo;
    private bool subscribed;
    private string? loadedKey;
    private CampaignHeader? header;
    private MarkdownEditor? composer;
    private IJSObjectReference? module;
    private readonly List<RollRow> rollRows = [];
    private int? rollsLoadedFor;
    private bool focusNewRoll;

    private string RollsDraftKey => $"thread-{ThreadId}";

    private bool OnLastPage => page is not null && page.Page >= page.PageCount;

    private bool TracksReading => campaign?.ViewerRole is CampaignRole.Player or CampaignRole.GameMaster;

    protected override async Task OnParametersSetAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        // Samma adress ska inte ladda om (t.ex. när förrenderingen blir interaktiv behövs ingen ny hämtning i onödan).
        var key = $"{CampaignId}/{ThreadId}?{PageQuery}/{PostQuery}/{ReplyQuery}/{QuoteQuery}";
        if (key == loadedKey)
            return;
        loadedKey = key;

        if (campaign?.Id != CampaignId)
            campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        thread = campaign is null ? null : await ThreadService.GetThreadAsync(CampaignId, ThreadId, userId);
        if (thread is null)
        {
            NavigationManager.NotFound();
            return;
        }

        firstUnreadId = TracksReading ? await Unread.GetFirstUnreadPostIdAsync(ThreadId, userId) : null;

        // Vilken sida? Fast länk till ett inlägg, en angiven sida, annars första olästa eller sista sidan (B28).
        int target;
        scrollTarget = null;
        scrollToTop = false;
        if (PostQuery is { } postId && await ThreadService.GetPageOfPostAsync(ThreadId, postId) is { } postPage)
        {
            target = postPage;
            scrollTarget = $"post-{postId}";
        }
        else if (PageQuery == "last" || ReplyQuery is not null || QuoteQuery is not null)
        {
            target = int.MaxValue;
            scrollTarget = ReplyQuery is not null || QuoteQuery is not null ? "composer" : null;
            scrollToTop = scrollTarget is null;
        }
        else if (int.TryParse(PageQuery, out var number))
        {
            target = number;
            scrollToTop = true;
        }
        else if (firstUnreadId is { } unread && await ThreadService.GetPageOfPostAsync(ThreadId, unread) is { } unreadPage)
        {
            target = unreadPage;
            scrollTarget = "first-unread";
        }
        else
        {
            target = int.MaxValue;
        }

        page = await ThreadService.GetPostsPageAsync(ThreadId, target, userId);
        now = DateTimeOffset.UtcNow;
        openMenu = null;
        copiedPostId = null;
        posts.Clear();
        posts.AddRange(page.Posts);
        newPostsElsewhere = 0;
        editingPostId = null;
        confirmDeleteId = null;
        actionError = null;

        confirmComplete = false;

        if (thread.CanWrite && postingLoadedFor != ThreadId)
        {
            postingLoadedFor = ThreadId;
            postingOptions = [.. await CharacterService.GetPostingOptionsAsync(CampaignId, userId)];

            // Samma val som förra gången i tråden (B37); annars spelarens första karaktär, eller GM:n som berättare.
            var last = await ThreadService.GetLastPostingChoiceAsync(ThreadId, userId);
            if (last.HasPosted && (last.CharacterId is null || postingOptions.Any(o => o.Id == last.CharacterId)))
                selectedCharacterId = last.CharacterId;
            else if (campaign!.ViewerRole == CampaignRole.Player && postingOptions.Count > 0)
                selectedCharacterId = postingOptions[0].Id;
            else
                selectedCharacterId = null;
        }

        if (ReplyQuery is { } replyId && await ThreadService.GetPostAsync(ThreadId, replyId, userId) is { } replied)
            replyTo = new PostReference(replied.Id, DisplayName(replied));
        pendingQuote = QuoteQuery;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Campaigns/ThreadPage.razor.js");
            Notifier.PostCreated += OnPostCreated;
            Notifier.PostChanged += OnPostChanged;
            subscribed = true;
        }

        if (module is null || page is null)
            return;

        // Slag som lagts till men inte postats ligger kvar i utkastet, som texten (B42).
        if (rollsLoadedFor != ThreadId)
        {
            rollsLoadedFor = ThreadId;
            rollRows.Clear();
            var saved = await module.InvokeAsync<string?>("loadRolls", RollsDraftKey);
            if (!string.IsNullOrEmpty(saved))
            {
                try
                {
                    rollRows.AddRange((JsonSerializer.Deserialize<List<RollRow>>(saved) ?? []).Take(ThreadLimits.MaxRollsPerPost));
                    foreach (var row in rollRows)
                        row.Validate();
                }
                catch (JsonException)
                {
                    // Ett trasigt utkast ignoreras.
                }
            }
            if (rollRows.Count > 0)
                StateHasChanged();
        }

        if (focusNewRoll)
        {
            focusNewRoll = false;
            await module.InvokeVoidAsync("focusLastRoll");
        }

        if (pendingQuote is { } quoteId && composer is not null && await ThreadService.GetPostAsync(ThreadId, quoteId, userId) is { } quoted)
        {
            pendingQuote = null;
            await composer.InsertAsync(QuoteText(quoted));
        }

        if (scrollTarget is { } target)
        {
            scrollTarget = null;
            await module.InvokeVoidAsync("scrollToElement", target);
        }
        else if (scrollToTop)
        {
            scrollToTop = false;
            await module.InvokeVoidAsync("scrollToTop");
        }

        await MarkReadAsync();
    }

    // Allt som visas på sidan räknas som läst.
    private async Task MarkReadAsync()
    {
        if (!TracksReading || posts.Count == 0)
            return;

        var last = posts[^1].Id;
        if (last <= markedReadUpTo)
            return;

        markedReadUpTo = last;
        try
        {
            await Unread.MarkReadAsync(ThreadId, userId, last);
            if (header is not null)
                await header.RefreshUnreadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Kunde inte markera tråd {ThreadId} som läst", ThreadId);
        }
    }

    private async Task<string?> SubmitAsync(string content)
    {
        foreach (var row in rollRows)
            row.Validate();
        if (rollRows.Any(r => r.Error is not null))
            return "Fix the dice rolls first.";

        var characterId = selectedCharacterId;
        PostItem created;
        try
        {
            created = await ThreadService.CreatePostAsync(CampaignId, ThreadId, userId, content, characterId, replyTo?.PostId, PendingRolls());
        }
        catch (CampaignRuleException ex)
        {
            return ex.Message;
        }

        replyTo = null;
        rollRows.Clear();
        await SaveRollsAsync();
        Notifier.NotifyPostCreated(CampaignId, ThreadId);

        // Karaktären flyttar upp bland "Recently used" i väljaren (B17).
        if (postingOptions.FindIndex(o => o.Id == characterId) is var index and >= 0)
            postingOptions[index] = postingOptions[index] with { LastUsedAt = DateTimeOffset.UtcNow };

        // Hamnar inlägget på en ny sida går vi dit; annars läggs det till här utan att sidan hoppar.
        if (posts.Count >= ThreadLimits.PostsPerPage)
        {
            NavigationManager.NavigateTo(ThreadLinks.Post(CampaignId, ThreadId, created.Id));
            return null;
        }

        await AppendNewPostsAsync();
        StateHasChanged();
        return null;
    }

    private async Task AppendNewPostsAsync()
    {
        var after = posts.Count > 0 ? posts[^1].Id : 0;
        var newer = await ThreadService.GetPostsAfterAsync(ThreadId, after, userId);

        // Egna inlägg kommer både härifrån och via notifieringen; samma inlägg får bara läggas till en gång.
        posts.AddRange(newer.Where(n => posts.All(p => p.Id != n.Id)));
        thread = await ThreadService.GetThreadAsync(CampaignId, ThreadId, userId) ?? thread;
        page = page! with { TotalCount = thread!.PostCount };
        await MarkReadAsync();
    }

    // Tomma rader räknas inte; en rad med bara beskrivning ger ett fel när inlägget postas.
    private List<RollRequest> PendingRolls() =>
        [.. rollRows.Where(r => !r.IsBlank).Select(r => new RollRequest(r.Notation, r.Label, r.Mode))];

    private async Task AddRollAsync()
    {
        if (rollRows.Count >= ThreadLimits.MaxRollsPerPost)
            return;
        // Formeln fylls i med kampanjens standardtärning (B46), så att man bara skriver till modifieraren.
        var row = new RollRow { Notation = campaign!.DefaultRoll };
        row.Validate();
        rollRows.Add(row);
        await SaveRollsAsync();
        focusNewRoll = true;
    }

    private async Task RemoveRollAsync(RollRow row)
    {
        rollRows.Remove(row);
        await SaveRollsAsync();
    }

    private async Task SetNotationAsync(RollRow row, string? value)
    {
        row.Notation = value ?? "";
        // Felet visas först när man lämnar fältet, så att "1d" inte blir rött mitt i skrivandet.
        row.Validate(showError: row.Error is not null);
        await SaveRollsAsync();
    }

    private async Task SetLabelAsync(RollRow row, string? value)
    {
        row.Label = value ?? "";
        await SaveRollsAsync();
    }

    private async Task SetModeAsync(RollRow row, string? value)
    {
        row.Mode = Enum.TryParse<DiceMode>(value, out var mode) ? mode : DiceMode.Normal;
        row.Validate();
        await SaveRollsAsync();
    }

    private async Task SaveRollsAsync()
    {
        if (module is null)
            return;
        try
        {
            await module.InvokeVoidAsync("saveRolls", RollsDraftKey, rollRows.Count == 0 ? null : JsonSerializer.Serialize(rollRows));
        }
        catch (JSDisconnectedException)
        {
            // Kretsen är nedkopplad; utkastet sparas nästa gång.
        }
    }

    /// <summary>En rad med ett tärningsslag i skrivfältet (B42). Kontrolleras medan man skriver och igen på servern.</summary>
    private sealed class RollRow
    {
        public string Notation { get; set; } = "";
        public string Label { get; set; } = "";
        public DiceMode Mode { get; set; }

        [JsonIgnore]
        public string? Error { get; private set; }

        [JsonIgnore]
        public bool SupportsMode { get; private set; }

        [JsonIgnore]
        public bool IsBlank => Notation.Trim().Length == 0 && Label.Trim().Length == 0;

        public void Validate(bool showError = true)
        {
            Error = null;
            SupportsMode = false;
            if (Notation.Trim().Length == 0)
            {
                Error = Label.Trim().Length > 0 ? "Enter the dice, e.g. 1d20+5." : null;
                Mode = DiceMode.Normal;
                return;
            }

            if (!DiceNotation.TryParse(Notation, out var notation, out var error))
            {
                Error = showError ? error : null;
                return;
            }

            SupportsMode = DiceRoll.SupportsMode(notation);
            if (!SupportsMode)
                Mode = DiceMode.Normal;
        }
    }

    private async Task ReplyAsync(PostItem post)
    {
        if (!OnLastPage)
        {
            NavigationManager.NavigateTo($"{ThreadLinks.Thread(CampaignId, ThreadId)}?reply={post.Id}");
            return;
        }

        replyTo = new PostReference(post.Id, DisplayName(post));
        if (module is not null)
            await module.InvokeVoidAsync("scrollToElement", "composer");
    }

    private async Task QuoteAsync(PostItem post)
    {
        if (!OnLastPage || composer is null)
        {
            NavigationManager.NavigateTo($"{ThreadLinks.Thread(CampaignId, ThreadId)}?quote={post.Id}");
            return;
        }

        await composer.InsertAsync(QuoteText(post));
        if (module is not null)
            await module.InvokeVoidAsync("scrollToElement", "composer");
    }

    // Citatet får slagens resultat som text under det citerade (B42); de blir inte nya slag.
    private static string QuoteText(PostItem post)
    {
        var parts = new List<string>();
        if (post.Content.Trim().Length > 0)
            parts.Add(post.Content);
        parts.AddRange(post.Rolls.Select(roll => "🎲 " + PostHtml.Describe(roll)));
        var lines = string.Join("\n", parts).Split('\n').Select(line => "> " + line.TrimEnd('\r'));
        return $"> **{DisplayName(post)}** wrote:\n{string.Join("\n", lines)}\n\n";
    }

    private static string DisplayName(PostItem post) => post.Character?.Name ?? post.AuthorName;

    // Namn och porträtt leder till karaktärens sida (B37), utom för en dold NPC som spelarna inte får se.
    private string? CharacterLink(PostCharacter character) =>
        character.IsHidden && campaign!.ViewerRole != CampaignRole.GameMaster
            ? null
            : $"campaigns/{CampaignId}/characters/{character.Id}";

    private async Task<string?> SaveEditAsync(long postId, string content)
    {
        try
        {
            var updated = await ThreadService.EditPostAsync(CampaignId, postId, userId, content);
            Replace(updated);
            editingPostId = null;
            Notifier.NotifyPostChanged(ThreadId, postId);
            StateHasChanged();
            return null;
        }
        catch (CampaignRuleException ex)
        {
            return ex.Message;
        }
    }

    private async Task DeleteAsync(long postId)
    {
        actionError = null;
        try
        {
            await ThreadService.DeletePostAsync(CampaignId, postId, userId);
        }
        catch (CampaignRuleException ex)
        {
            actionError = ex.Message;
            return;
        }

        confirmDeleteId = null;
        if (await ThreadService.GetPostAsync(ThreadId, postId, userId) is { } deleted)
            Replace(deleted);
        Notifier.NotifyPostChanged(ThreadId, postId);
    }

    private Task CompleteAsync() => ChangeStatusAsync(() => ThreadService.CompleteThreadAsync(CampaignId, ThreadId, userId));

    private Task ReopenAsync() => ChangeStatusAsync(() => ThreadService.ReopenThreadAsync(CampaignId, ThreadId, userId));

    private async Task ChangeStatusAsync(Func<Task> change)
    {
        actionError = null;
        openMenu = null;
        try
        {
            await change();
        }
        catch (CampaignRuleException ex)
        {
            actionError = ex.Message;
            return;
        }

        thread = await ThreadService.GetThreadAsync(CampaignId, ThreadId, userId) ?? thread;
        loadedKey = null;
        NavigationManager.NavigateTo(ThreadLinks.Latest(CampaignId, ThreadId));
    }

    private void Replace(PostItem updated)
    {
        var index = posts.FindIndex(p => p.Id == updated.Id);
        if (index >= 0)
            posts[index] = updated;
    }

    private void OnPostCreated(int campaignId, int threadId)
    {
        if (threadId != ThreadId)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                // Bara den som står på sista sidan får inläggen direkt; andra ser en rad om nya inlägg (B28).
                if (OnLastPage && posts.Count < ThreadLimits.PostsPerPage)
                    await AppendNewPostsAsync();
                else
                    newPostsElsewhere++;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Kunde inte hämta nya inlägg i tråd {ThreadId}", ThreadId);
            }
        });
    }

    private void OnPostChanged(int threadId, long postId)
    {
        if (threadId != ThreadId || posts.All(p => p.Id != postId) || editingPostId == postId)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                if (await ThreadService.GetPostAsync(ThreadId, postId, userId) is { } updated)
                {
                    Replace(updated);
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Kunde inte hämta ändrat inlägg {PostId}", postId);
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (subscribed)
        {
            Notifier.PostCreated -= OnPostCreated;
            Notifier.PostChanged -= OnPostChanged;
        }

        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Kretsen är redan nedkopplad.
            }
        }
    }

    private void ToggleMenu(string key) => openMenu = openMenu == key ? null : key;

    private void CloseMenu() => openMenu = null;

    private async Task CopyLinkAsync(PostItem post)
    {
        openMenu = null;
        if (module is null)
            return;

        var url = NavigationManager.ToAbsoluteUri(ThreadLinks.Post(CampaignId, ThreadId, post.Id)).ToString();
        copiedPostId = await module.InvokeAsync<bool>("copyText", url) ? post.Id : null;
    }

    private RenderFragment PostView(PostItem post) =>
        @<article id="post-@post.Id" class="thread-post @(post.AuthorIsGameMaster ? "post-gm" : "") @(post.Id == PostQuery ? "post-target" : "") @(post.IsDeleted ? "post-is-deleted" : "")">
            <div class="post-avatar">
                @if (post.IsDeleted)
                {
                    <span class="post-avatar-deleted" aria-hidden="true"></span>
                }
                else if (post.Character is { } character && CharacterLink(character) is { } avatarLink)
                {
                    <a href="@avatarLink" class="post-avatar-link" tabindex="-1" aria-hidden="true">
                        <Avatar Name="@character.Name" ImageUrl="@character.AvatarUrl" ColorKey="@($"character-{character.Id}")" Size="56" />
                    </a>
                }
                else if (post.Character is { } hidden)
                {
                    <Avatar Name="@hidden.Name" ImageUrl="@hidden.AvatarUrl" ColorKey="@($"character-{hidden.Id}")" Size="56"
                            Silhouette="@(hidden.IsHidden && campaign!.ViewerRole != CampaignRole.GameMaster)" />
                }
                else if (!post.AuthorIsDeleted)
                {
                    @* Utan karaktär leder bilden och namnet till användarens profil (B52). *@
                    <a href="@UserLinks.Profile(post.AuthorId)" class="post-avatar-link" tabindex="-1" aria-hidden="true">
                        <Avatar Name="@post.AuthorName" ImageUrl="@post.AuthorAvatarUrl" ColorKey="@post.AuthorId" Size="56" />
                    </a>
                }
                else
                {
                    <Avatar Name="@post.AuthorName" ColorKey="@post.AuthorId" Size="56" />
                }
            </div>
            <div class="post-body">
                @if (post.IsDeleted)
                {
                    <div class="text-secondary fst-italic post-deleted">This post was deleted.</div>
                }
                else
                {
                    <header class="post-header">
                        @if (post.Character is { } named && CharacterLink(named) is { } nameLink)
                        {
                            <a class="post-author post-author-link" href="@nameLink">@named.Name</a>
                        }
                        else if (post.Character is null && !post.AuthorIsDeleted)
                        {
                            <a class="post-author post-author-link post-user-link" href="@UserLinks.Profile(post.AuthorId)">@post.AuthorName</a>
                        }
                        else
                        {
                            <strong class="post-author">@(post.Character?.Name ?? post.AuthorName)</strong>
                        }
                        @if (post.Character is { IsNpc: true } npc)
                        {
                            <span class="badge rounded-pill text-bg-secondary">NPC</span>
                            @if (npc.IsHidden && campaign!.ViewerRole == CampaignRole.GameMaster)
                            {
                                <span class="badge rounded-pill text-bg-warning" title="Players see: @(npc.Alias ?? Character.UnknownName)">Hidden</span>
                            }
                        }
                        else if (post.Character is not null)
                        {
                            @if (post.AuthorIsDeleted)
                            {
                                <span class="small text-secondary post-player">@post.AuthorName</span>
                            }
                            else
                            {
                                <a class="small text-secondary post-player" href="@UserLinks.Profile(post.AuthorId)">@post.AuthorName</a>
                            }
                        }
                        else if (post.AuthorIsGameMaster)
                        {
                            <span class="badge rounded-pill text-bg-dark">GM</span>
                        }
                        <a class="text-secondary small post-time" href="@ThreadLinks.Post(CampaignId, ThreadId, post.Id)" title="@Dates.DateTime(post.CreatedAt)">
                            <time datetime="@post.CreatedAt.ToString("o")">@Dates.Relative(post.CreatedAt, now)</time>
                        </a>
                        @if (post.EditedAt is { } editedAt)
                        {
                            <span class="small text-secondary post-edited" title="Edited @Dates.DateTime(editedAt)">(edited)</span>
                        }
                        @if (copiedPostId == post.Id)
                        {
                            <span class="small text-success" role="status">Link copied</span>
                        }
                        @* Reply syns alltid uppe till höger; övriga åtgärder ligger i "…"-menyn (B44). *@
                        @if (thread!.CanWrite)
                        {
                            <button type="button" class="btn btn-sm btn-link post-action ms-auto" title="Reply" aria-label="Reply"
                                    @onclick="() => ReplyAsync(post)"><Icon Name="reply" /></button>
                        }
                        <div class="menu-anchor @(thread!.CanWrite ? "" : "ms-auto")">
                            <button type="button" class="btn btn-sm btn-link post-menu-toggle" title="More" aria-label="More actions"
                                    aria-expanded="@(openMenu == $"post-{post.Id}" ? "true" : "false")" @onclick="@(() => ToggleMenu($"post-{post.Id}"))">
                                <Icon Name="three-dots" />
                            </button>
                            @if (openMenu == $"post-{post.Id}")
                            {
                                <div class="menu-backdrop" @onclick="CloseMenu"></div>
                                <div class="action-menu border rounded shadow-sm" role="menu">
                                    @if (thread!.CanWrite)
                                    {
                                        <button type="button" class="action-menu-item" role="menuitem"
                                                @onclick="() => { openMenu = null; return QuoteAsync(post); }"><Icon Name="quote" /> Quote</button>
                                    }
                                    @if (post.CanEdit)
                                    {
                                        <button type="button" class="action-menu-item" role="menuitem"
                                                @onclick="() => { editingPostId = post.Id; confirmDeleteId = null; openMenu = null; }"><Icon Name="pencil" /> Edit</button>
                                    }
                                    <button type="button" class="action-menu-item" role="menuitem" @onclick="() => CopyLinkAsync(post)"><Icon Name="link" /> Copy link</button>
                                    @if (post.CanDelete)
                                    {
                                        <button type="button" class="action-menu-item text-danger" role="menuitem"
                                                @onclick="() => { confirmDeleteId = post.Id; editingPostId = null; openMenu = null; }"><Icon Name="trash" /> Delete</button>
                                    }
                                </div>
                            }
                        </div>
                    </header>
                    @if (post.ReplyTo is { } reply)
                    {
                        <div class="small text-secondary post-reply"><Icon Name="reply" /> Replying to <a href="@ThreadLinks.Post(CampaignId, ThreadId, reply.PostId)">@reply.Name</a></div>
                    }
                    @if (editingPostId == post.Id)
                    {
                        <MarkdownEditor @key="post.Id" MaxLength="ThreadLimits.PostMaxLength" DraftKey="" InitialText="@post.Content"
                                        OnSubmit="@(content => SaveEditAsync(post.Id, content))" SubmitText="Save"
                                        ShortcutHint="Ctrl+Enter saves" Label="Edit post" Rows="5" ShowOocButton="true" ShowSpoilerButton="true"
                                        AllowEmpty="@(post.Rolls.Count > 0)" RenderPreview="@(text => PostHtml.Preview(Markdown, text))">
                            <BelowText>
                                @if (post.Rolls.Count > 0)
                                {
                                    <DiceRolls Rolls="post.Rolls" />
                                    <small class="text-secondary">The dice rolls can't be changed.</small>
                                }
                            </BelowText>
                        </MarkdownEditor>
                        <button type="button" class="btn btn-sm btn-link px-0" @onclick="() => editingPostId = null">Cancel</button>
                    }
                    else
                    {
                        @if (post.Content.Trim().Length > 0)
                        {
                            <div class="post-content">@PostHtml.Render(Markdown, post.Content)</div>
                        }
                        <DiceRolls Rolls="post.Rolls" />
                        @if (confirmDeleteId == post.Id)
                        {
                            <div class="small post-confirm-delete">
                                Delete this post?
                                <button type="button" class="btn btn-sm btn-danger py-0 ms-1" @onclick="() => DeleteAsync(post.Id)">Yes, delete</button>
                                <button type="button" class="btn btn-sm btn-link py-0" @onclick="() => confirmDeleteId = null">Cancel</button>
                            </div>
                        }
                    }
                }
            </div>
        </article>;
}