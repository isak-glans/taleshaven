@page "/campaigns/{CampaignId:int}/chronicle"
@attribute [Authorize]

@using Taleshaven.Core.Chronicle

@* Krönikan läses som en bok: alla kapitel i följd, äldst först, med sidindelning (beslut B10). *@

@inject ICampaignService CampaignService
@inject IChronicleService ChronicleService
@inject IMarkdownRenderer Markdown
@inject NavigationManager NavigationManager

@if (campaign is null || chronicle is null)
{
    return;
}

<PageTitle>Krönika · @campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="CampaignTab.Chronicle" />

@if (errorMessage is not null)
{
    <div class="alert alert-danger py-2">@errorMessage</div>
}

<div class="chronicle">
    @if (chronicle.ChapterCount == 0)
    {
        <p class="text-secondary">Krönikan är tom.@(chronicle.CanEdit ? "" : " GM har inte skrivit något kapitel än.")</p>
        @if (chronicle.CanEdit)
        {
            <a class="btn btn-primary" href="@NewChapterLink">Skriv första kapitlet</a>
        }
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <a class="btn btn-sm btn-outline-secondary" href="@ChapterLink(1)">Läs från början</a>
            <a class="btn btn-sm btn-outline-secondary" href="@ChapterLink(chronicle.ChapterCount)">Senaste kapitlet</a>
            @if (chronicle.CanEdit)
            {
                <a class="btn btn-sm btn-primary ms-auto" href="@NewChapterLink">Nytt kapitel</a>
            }
        </div>

        <nav class="chronicle-contents mb-4" aria-labelledby="chronicle-contents-heading">
            <details open>
                <summary id="chronicle-contents-heading" class="fw-semibold">Innehåll (@chronicle.ChapterCount kapitel)</summary>
                <ol class="chronicle-toc mt-2">
                    @foreach (var entry in chronicle.Contents)
                    {
                        <li value="@entry.Number">
                            <a href="@ChapterLink(entry.Number)">@entry.Title</a>
                            @if (entry.Number == chronicle.ChapterCount)
                            {
                                <span class="badge text-bg-primary ms-1">Senaste</span>
                            }
                        </li>
                    }
                </ol>
            </details>
        </nav>

        @foreach (var chapter in chronicle.Chapters)
        {
            <article class="chronicle-chapter" id="kapitel-@chapter.Number">
                <header>
                    <div class="chronicle-chapter-number">
                        Kapitel @chapter.Number
                        @if (chapter.Number == chronicle.ChapterCount)
                        {
                            <span class="badge text-bg-primary ms-1">Senaste</span>
                        }
                    </div>
                    <h2 class="chronicle-chapter-title">@chapter.Title</h2>
                    <div class="small text-secondary">
                        @chapter.AuthorName · @Dates.Date(chapter.CreatedAt)
                        @if (Dates.Date(chapter.UpdatedAt) != Dates.Date(chapter.CreatedAt))
                        {
                            <text> · ändrat @Dates.Date(chapter.UpdatedAt)</text>
                        }
                    </div>
                </header>

                <div class="post-content chronicle-text">@((MarkupString)Markdown.ToSafeHtml(chapter.Content))</div>

                @if (chronicle.CanEdit)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <a class="btn btn-sm btn-outline-secondary" href="campaigns/@CampaignId/chronicle/@chapter.Id/edit">Redigera</a>
                        <form method="post" @formname="@($"move-{chapter.Id}")" @onsubmit="MoveAsync" class="d-flex gap-1">
                            <AntiforgeryToken />
                            <input type="hidden" name="Move.ChapterId" value="@chapter.Id" />
                            <button type="submit" name="Move.Direction" value="-1" class="btn btn-sm btn-outline-secondary"
                                    title="Flytta tidigare i boken" aria-label="Flytta kapitel @chapter.Number tidigare" disabled="@(chapter.Number == 1)">↑</button>
                            <button type="submit" name="Move.Direction" value="1" class="btn btn-sm btn-outline-secondary"
                                    title="Flytta senare i boken" aria-label="Flytta kapitel @chapter.Number senare" disabled="@(chapter.Number == chronicle.ChapterCount)">↓</button>
                        </form>
                    </div>
                }
            </article>
        }

        @if (chronicle.PageCount > 1)
        {
            <nav aria-label="Sidor i krönikan">
                <p class="text-center text-secondary small mb-2">Sida @chronicle.Page av @chronicle.PageCount</p>
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(chronicle.Page == 1 ? "disabled" : "")">
                        <a class="page-link" href="@PageLink(chronicle.Page - 1)">Föregående</a>
                    </li>
                    @for (var p = 1; p <= chronicle.PageCount; p++)
                    {
                        <li class="page-item @(p == chronicle.Page ? "active" : "")">
                            <a class="page-link" href="@PageLink(p)" aria-current="@(p == chronicle.Page ? "page" : null)">@p</a>
                        </li>
                    }
                    <li class="page-item @(chronicle.Page == chronicle.PageCount ? "disabled" : "")">
                        <a class="page-link" href="@PageLink(chronicle.Page + 1)">Nästa</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [SupplyParameterFromQuery(Name = "sida")]
    private int? Page { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    // Binds från GM:ns flytta-formulär (ett per kapitel).
    [SupplyParameterFromForm]
    private MoveModel? Move { get; set; }

    private string userId = "";
    private CampaignDetails? campaign;
    private ChronicleView? chronicle;
    private string? errorMessage;

    private string NewChapterLink => $"campaigns/{CampaignId}/chronicle/new";

    private string PageLink(int page) => $"campaigns/{CampaignId}/chronicle?sida={page}";

    private string ChapterLink(int number) => $"campaigns/{CampaignId}/chronicle?sida={ChronicleLimits.PageOf(number)}#kapitel-{number}";

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign is null)
        {
            NavigationManager.NotFound();
            return;
        }

        chronicle = await ChronicleService.GetPageAsync(CampaignId, Page ?? 1, userId);
    }

    private async Task MoveAsync()
    {
        if (Move is not { ChapterId: { } chapterId, Direction: -1 or 1 })
            return;

        int number;
        try
        {
            number = await ChronicleService.MoveChapterAsync(CampaignId, chapterId, userId, Move.Direction.Value);
        }
        catch (CampaignRuleException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        NavigationManager.NavigateTo(ChapterLink(number));
    }

    private sealed class MoveModel
    {
        public int? ChapterId { get; set; }
        public int? Direction { get; set; }
    }
}
