@page "/campaigns/{CampaignId:int}/chronicle"
@attribute [Authorize]

@using Taleshaven.Core.Chronicle

@* Krönikan läses som en bok, ett kapitel i taget (B10, B14). Kapitlet visas i en läsyta som fyller resten av
   skärmen, så att rubrik och flikar alltid syns; sidnavigeringen ligger fast under läsytan. *@

@inject ICampaignService CampaignService
@inject IChronicleService ChronicleService
@inject IMarkdownRenderer Markdown
@inject NavigationManager NavigationManager

@if (campaign is null || chronicle is null)
{
    return;
}

<PageTitle>@(Chapter is { } current ? $"{current.Title} · " : "")Krönika · @campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="CampaignTab.Chronicle" />

@if (errorMessage is not null)
{
    <div class="alert alert-danger py-2">@errorMessage</div>
}

<div class="chronicle">
    @if (Chapter is null)
    {
        <p class="text-secondary">Krönikan är tom.@(chronicle.CanEdit ? "" : " GM har inte skrivit något kapitel än.")</p>
        @if (chronicle.CanEdit)
        {
            <a class="btn btn-primary" href="@ChronicleLinks.NewChapter(CampaignId)">Skriv första kapitlet</a>
        }
    }
    else
    {
        <div class="chronicle-toolbar d-flex flex-wrap align-items-center gap-2 mb-2">
            @* Innehållet öppnas som en meny över texten, så att läsytan inte flyttas. *@
            <details class="chronicle-contents">
                <summary class="btn btn-sm btn-outline-secondary">Innehåll (@chronicle.ChapterCount kapitel)</summary>
                <nav class="chronicle-contents-menu" aria-label="Innehåll">
                    <ol class="chronicle-toc mb-0">
                        @foreach (var entry in chronicle.Contents)
                        {
                            <li value="@entry.Number" class="@(entry.Number == Chapter.Number ? "current" : "")">
                                <a href="@ChronicleLinks.Chapter(CampaignId, entry.Number)"
                                   aria-current="@(entry.Number == Chapter.Number ? "page" : null)">@entry.Title</a>
                                @if (entry.Number == chronicle.ChapterCount)
                                {
                                    <span class="badge text-bg-primary ms-1">Senaste</span>
                                }
                            </li>
                        }
                    </ol>
                </nav>
            </details>
            @if (Chapter.Number != 1)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@ChronicleLinks.Chapter(CampaignId, 1)">Läs från början</a>
            }
            @if (Chapter.Number != chronicle.ChapterCount)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@ChronicleLinks.Chapter(CampaignId, chronicle.ChapterCount)">Senaste kapitlet</a>
            }
            @if (chronicle.CanEdit)
            {
                <a class="btn btn-sm btn-primary ms-auto" href="@ChronicleLinks.NewChapter(CampaignId)">Nytt kapitel</a>
            }
        </div>

        <div class="chronicle-reader">
            <div class="chronicle-panel border rounded" data-fill-viewport tabindex="0" aria-label="Kapitel @Chapter.Number">
                <article class="chronicle-chapter" id="kapitel-@Chapter.Number">
                    <header>
                        <div class="chronicle-chapter-number">
                            Kapitel @Chapter.Number av @chronicle.ChapterCount
                            @if (Chapter.Number == chronicle.ChapterCount)
                            {
                                <span class="badge text-bg-primary ms-1">Senaste</span>
                            }
                        </div>
                        <h2 class="chronicle-chapter-title">@Chapter.Title</h2>
                        <div class="small text-secondary">
                            @Chapter.AuthorName · @Dates.Date(Chapter.CreatedAt)
                            @if (Dates.Date(Chapter.UpdatedAt) != Dates.Date(Chapter.CreatedAt))
                            {
                                <text> · ändrat @Dates.Date(Chapter.UpdatedAt)</text>
                            }
                        </div>
                    </header>

                    <div class="post-content chronicle-text">@((MarkupString)Markdown.ToSafeHtml(Chapter.Content))</div>

                    @if (chronicle.CanEdit)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-4">
                            <a class="btn btn-sm btn-outline-secondary" href="@ChronicleLinks.EditChapter(CampaignId, Chapter.Id)">Redigera</a>
                            <form method="post" @formname="@($"move-{Chapter.Id}")" @onsubmit="MoveAsync" class="d-flex gap-1">
                                <AntiforgeryToken />
                                <input type="hidden" name="Move.ChapterId" value="@Chapter.Id" />
                                <button type="submit" name="Move.Direction" value="-1" class="btn btn-sm btn-outline-secondary"
                                        title="Flytta tidigare i boken" aria-label="Flytta kapitel @Chapter.Number tidigare" disabled="@(Chapter.Number == 1)">↑</button>
                                <button type="submit" name="Move.Direction" value="1" class="btn btn-sm btn-outline-secondary"
                                        title="Flytta senare i boken" aria-label="Flytta kapitel @Chapter.Number senare" disabled="@(Chapter.Number == chronicle.ChapterCount)">↓</button>
                            </form>
                        </div>
                    }
                </article>
            </div>

            <div data-fill-below>
                <ChroniclePager CampaignId="CampaignId" Page="chronicle.Page" PageCount="chronicle.PageCount" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [SupplyParameterFromQuery(Name = "sida")]
    private int? Page { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    // Binds från GM:ns flytta-formulär.
    [SupplyParameterFromForm]
    private MoveModel? Move { get; set; }

    private string userId = "";
    private CampaignDetails? campaign;
    private ChronicleView? chronicle;
    private string? errorMessage;

    // Ett kapitel per sida.
    private ChapterView? Chapter => chronicle?.Chapters.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign is null)
        {
            NavigationManager.NotFound();
            return;
        }

        chronicle = await ChronicleService.GetPageAsync(CampaignId, Page ?? 1, userId);
    }

    private async Task MoveAsync()
    {
        if (Move is not { ChapterId: { } chapterId, Direction: -1 or 1 })
            return;

        int number;
        try
        {
            number = await ChronicleService.MoveChapterAsync(CampaignId, chapterId, userId, Move.Direction.Value);
        }
        catch (CampaignRuleException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        NavigationManager.NavigateTo(ChronicleLinks.Chapter(CampaignId, number));
    }

    private sealed class MoveModel
    {
        public int? ChapterId { get; set; }
        public int? Direction { get; set; }
    }
}
