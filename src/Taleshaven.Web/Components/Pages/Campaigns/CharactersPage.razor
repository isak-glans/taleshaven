@page "/campaigns/{CampaignId:int}/characters"
@attribute [Authorize]

@using Taleshaven.Core.Characters

@inject ICampaignService CampaignService
@inject ICharacterService CharacterService
@inject NavigationManager NavigationManager

@if (campaign is null || characters is null)
{
    return;
}

<PageTitle>Characters · @campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="CampaignTab.Characters" />

@if (characters.CanCreate)
{
    <a class="btn btn-primary btn-sm mb-3" href="campaigns/@CampaignId/characters/new">
        @(campaign.ViewerRole == CampaignRole.GameMaster ? "New NPC" : "New character")
    </a>
}

<h2 class="h5">Player characters</h2>
@if (characters.PlayerCharacters.Count == 0)
{
    <p class="text-secondary">No characters yet.</p>
}
else
{
    <CharacterGrid CampaignId="CampaignId" Characters="characters.PlayerCharacters" />
}

<h2 class="h5 mt-4">NPCs</h2>
@if (characters.Npcs.Count == 0)
{
    <p class="text-secondary">@(characters.ArchivedNpcs.Count > 0 ? "All NPCs are archived." : "The GM hasn't added any NPCs.")</p>
}
else
{
    <CharacterGrid CampaignId="CampaignId" Characters="characters.Npcs" />
}

@if (characters.ArchivedNpcs.Count > 0)
{
    @* Arkiverade NPC:er syns inte i "Skriv som" men finns kvar i gamla inlägg (B17). *@
    <details class="mt-3">
        <summary class="text-secondary">Archived NPCs (@characters.ArchivedNpcs.Count)</summary>
        <div class="mt-2">
            <CharacterGrid CampaignId="CampaignId" Characters="characters.ArchivedNpcs" />
        </div>
    </details>
}

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private CampaignDetails? campaign;
    private CharacterList? characters;

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthenticationState).User.GetUserId() ?? "";

        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign is null)
        {
            NavigationManager.NotFound();
            return;
        }

        characters = await CharacterService.GetCharactersAsync(CampaignId, userId);
    }
}
