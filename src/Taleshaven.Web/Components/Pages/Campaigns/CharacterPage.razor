@page "/campaigns/{CampaignId:int}/characters/{CharacterId:int}"
@attribute [Authorize]

@using Taleshaven.Core.Characters

@inject ICampaignService CampaignService
@inject ICharacterService CharacterService
@inject IMarkdownRenderer Markdown
@inject NavigationManager NavigationManager

@if (campaign is null || character is null)
{
    return;
}

<PageTitle>@character.Name · @campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="CampaignTab.Characters" />

<p class="small mb-2"><a href="campaigns/@CampaignId/characters">Karaktärer</a> ›</p>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <Avatar Name="@character.Name" ImageUrl="@character.AvatarUrl" ColorKey="@($"character-{character.Id}")" Size="96" />
    <div>
        <h2 class="h3 mb-1">
            @character.Name
            @if (character.IsNpc)
            {
                <span class="badge text-bg-secondary align-middle">NPC</span>
            }
            @if (character.IsArchived)
            {
                <span class="badge text-bg-light border align-middle">Arkiverad</span>
            }
        </h2>
        <div class="text-secondary small">
            @(character.IsNpc ? "NPC hos GM" : $"Spelas av {character.OwnerName}")
            @if (!character.IsNpc && character.RuleSystem is not null)
            {
                <text> · @character.RuleSystem</text>
            }
            · uppdaterad @Dates.DateTime(character.UpdatedAt)
        </div>
        @if (!character.IsNpc && character.SheetUrl is not null)
        {
            <a class="small" href="@character.SheetUrl" target="_blank" rel="nofollow noopener noreferrer">Fullständigt rollformulär ↗</a>
        }
    </div>
    @if (character.CanEdit)
    {
        <div class="d-flex gap-2 ms-auto">
            @if (character.IsNpc)
            {
                @* Arkiverade NPC:er göms i "Skriv som" men finns kvar i gamla inlägg (B17). *@
                <form method="post" @formname="archive" @onsubmit="SetArchivedAsync">
                    <AntiforgeryToken />
                    <input type="hidden" name="Archive" value="@(character.IsArchived ? "false" : "true")" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm"
                            title="@(character.IsArchived ? "Visa NPC:n i Skriv som igen" : "Göm NPC:n i Skriv som")">
                        @(character.IsArchived ? "Återställ" : "Arkivera")
                    </button>
                </form>
            }
            <a class="btn btn-outline-secondary btn-sm" href="campaigns/@CampaignId/characters/@character.Id/edit">Redigera</a>
        </div>
    }
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (character.IsNpc)
{
    @* NPC:er har inget dokument (B15). Anteckningen skickas bara till GM, så för spelare är den alltid null. *@
    @if (character.GmNote is not null)
    {
        <div class="card border-warning gm-note">
            <div class="card-header small">Anteckning – bara du som GM ser den</div>
            <div class="card-body post-content">@((MarkupString)Markdown.ToSafeHtml(character.GmNote))</div>
        </div>
    }
}
else if (character.Sheet.Length == 0)
{
    <p class="text-secondary">Karaktärsdokumentet är inte ifyllt än.</p>
}
else
{
    <div class="post-content character-sheet card card-body">@((MarkupString)Markdown.ToSafeHtml(character.Sheet))</div>
}

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [Parameter]
    public int CharacterId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    // Binds från GM:ns arkivera-formulär.
    [SupplyParameterFromForm]
    private bool? Archive { get; set; }

    private string userId = "";
    private CampaignDetails? campaign;
    private CharacterDetails? character;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        character = campaign is null ? null : await CharacterService.GetCharacterAsync(CampaignId, CharacterId, userId);
        if (character is null)
            NavigationManager.NotFound();
    }

    private async Task SetArchivedAsync()
    {
        if (Archive is not { } archived)
            return;

        try
        {
            await CharacterService.SetArchivedAsync(CampaignId, CharacterId, userId, archived);
        }
        catch (CampaignRuleException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        NavigationManager.NavigateTo($"campaigns/{CampaignId}/characters/{CharacterId}");
    }
}
