@page "/campaigns/{CampaignId:int}/threads/new"
@page "/campaigns/{CampaignId:int}/threads/{ThreadId:int}/edit"
@attribute [Authorize]
@rendermode InteractiveServer

@* GM skapar och redigerar trådar (B25): titel, typ (bara när tråden skapas) och introduktion. *@

@inject ICampaignService CampaignService
@inject IThreadService ThreadService
@inject NavigationManager NavigationManager

@if (!loaded || LoadedCampaign is null)
{
    return;
}

<PageTitle>@Heading · @LoadedCampaign.Name</PageTitle>

<CampaignHeader Campaign="LoadedCampaign" Active="CampaignTab.Threads" />

@if (!CampaignPermissions.CanManageThreads(LoadedCampaign.ViewerRole))
{
    <div class="alert alert-warning">Only the campaign's GM can manage threads.</div>
    return;
}

<div class="thread-editor">
    <h2 class="h4 mb-3">@Heading</h2>

    <div class="mb-3">
        <label for="thread-title" class="form-label">Title</label>
        <input id="thread-title" class="form-control" maxlength="@ThreadLimits.TitleMaxLength"
               placeholder="E.g. Chapter 1 – Arrival, or OOC" @bind="title" />
    </div>

    @if (LoadedThread is null)
    {
        <fieldset class="mb-3">
            <legend class="form-label fs-6">Type</legend>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="thread-kind" id="kind-story" checked="@(kind == ThreadKind.Story)"
                       @onchange="() => kind = ThreadKind.Story" />
                <label class="form-check-label" for="kind-story">Story <span class="text-secondary small">– part of the narrative, e.g. a chapter or a scene. Gets a chronicle when completed.</span></label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="thread-kind" id="kind-discussion" checked="@(kind == ThreadKind.Discussion)"
                       @onchange="() => kind = ThreadKind.Discussion" />
                <label class="form-check-label" for="kind-discussion">Discussion <span class="text-secondary small">– everything outside the story: OOC, rules questions, planning.</span></label>
            </div>
        </fieldset>
    }

    <label class="form-label">Introduction <span class="text-secondary">(optional)</span></label>
    <MarkdownEditor @key="ThreadId" MaxLength="ThreadLimits.IntroductionMaxLength" DraftKey="@DraftKey"
                    InitialText="@LoadedThread?.Introduction" OnSubmit="SaveAsync" AllowEmpty="true"
                    SubmitText="@(LoadedThread is null ? "Create thread" : "Save thread")" ShortcutHint="Ctrl+Enter saves"
                    Label="Introduction" Rows="8"
                    Placeholder="How the scene begins, or what the discussion is for…" />

    <a class="btn btn-link px-0 mt-2" href="@BackLink">Cancel</a>
</div>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [Parameter]
    public int? ThreadId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    // Förs över från förrenderingen så att sidan inte blinkar tom och editorn får texten direkt.
    [PersistentState]
    public CampaignDetails? LoadedCampaign { get; set; }

    [PersistentState]
    public ThreadDetails? LoadedThread { get; set; }

    private string userId = "";
    private bool loaded;
    private string? title;
    private ThreadKind kind = ThreadKind.Story;

    private string Heading => LoadedThread is null ? "New thread" : $"Edit {LoadedThread.Title}";

    private string DraftKey => ThreadId is null ? $"thread-new-{CampaignId}" : $"thread-intro-{ThreadId}";

    private string BackLink => LoadedThread is null ? ThreadLinks.Threads(CampaignId) : ThreadLinks.Thread(CampaignId, LoadedThread.Id);

    protected override async Task OnParametersSetAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        if (LoadedCampaign?.Id != CampaignId)
            LoadedCampaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (LoadedCampaign is null)
        {
            NavigationManager.NotFound();
            return;
        }

        if (ThreadId is null)
        {
            LoadedThread = null;
        }
        else if (LoadedThread?.Id != ThreadId)
        {
            LoadedThread = await ThreadService.GetThreadAsync(CampaignId, ThreadId.Value, userId);
            if (LoadedThread is null)
            {
                NavigationManager.NotFound();
                return;
            }
        }

        if (!loaded)
            title = LoadedThread?.Title;
        loaded = true;
    }

    private async Task<string?> SaveAsync(string introduction)
    {
        try
        {
            int id;
            if (LoadedThread is null)
            {
                id = await ThreadService.CreateThreadAsync(CampaignId, userId, kind, title, introduction);
            }
            else
            {
                await ThreadService.UpdateThreadAsync(CampaignId, LoadedThread.Id, userId, title, introduction);
                id = LoadedThread.Id;
            }

            NavigationManager.NavigateTo(ThreadLinks.Thread(CampaignId, id));
            return null;
        }
        catch (CampaignRuleException ex)
        {
            return ex.Message;
        }
    }
}
