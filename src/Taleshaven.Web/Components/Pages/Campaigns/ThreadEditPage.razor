@page "/campaigns/{CampaignId:int}/threads/new"
@page "/campaigns/{CampaignId:int}/threads/{ThreadId:int}/edit"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations

@* GM skapar och döper om trådar (B25, B37). En tråd har bara en titel. *@

@inject ICampaignService CampaignService
@inject IThreadService ThreadService
@inject NavigationManager NavigationManager

@if (campaign is null)
{
    return;
}

<PageTitle>@Heading · @campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="CampaignTab.Threads" />

@if (!CampaignPermissions.CanManageThreads(campaign.ViewerRole))
{
    <div class="alert alert-warning">Only the campaign's GM can manage threads.</div>
    return;
}

<div class="thread-editor" style="max-width: 36rem">
    <h2 class="h4 mb-3">@Heading</h2>

    <EditForm Model="Input" method="post" OnValidSubmit="SaveAsync" FormName="thread">
        <DataAnnotationsValidator />
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@errorMessage</div>
        }
        <div class="mb-3">
            <label for="thread-title" class="form-label">Title</label>
            <InputText @bind-Value="Input.Title" id="thread-title" class="form-control" maxlength="@ThreadLimits.TitleMaxLength"
                       placeholder="E.g. Chapter 1 – Arrival, OOC or Chronicle" autofocus />
            <ValidationMessage For="() => Input.Title" class="text-danger" />
        </div>
        <button type="submit" class="btn btn-primary">@(thread is null ? "Create thread" : "Save")</button>
        <a class="btn btn-link" href="@BackLink">Cancel</a>
    </EditForm>
</div>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [Parameter]
    public int? ThreadId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "thread")]
    private InputModel Input { get; set; } = default!;

    private string userId = "";
    private CampaignDetails? campaign;
    private ThreadDetails? thread;
    private string? errorMessage;

    private string Heading => thread is null ? "New thread" : $"Rename {thread.Title}";

    private string BackLink => thread is null ? ThreadLinks.Threads(CampaignId) : ThreadLinks.Thread(CampaignId, thread.Id);

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign is null)
        {
            NavigationManager.NotFound();
            return;
        }

        if (ThreadId is { } id)
        {
            thread = await ThreadService.GetThreadAsync(CampaignId, id, userId);
            if (thread is null)
            {
                NavigationManager.NotFound();
                return;
            }
        }

        Input ??= new() { Title = thread?.Title };
    }

    private async Task SaveAsync()
    {
        int id;
        try
        {
            if (thread is null)
            {
                id = await ThreadService.CreateThreadAsync(CampaignId, userId, Input.Title);
            }
            else
            {
                await ThreadService.RenameThreadAsync(CampaignId, thread.Id, userId, Input.Title);
                id = thread.Id;
            }
        }
        catch (CampaignRuleException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        NavigationManager.NavigateTo(ThreadLinks.Thread(CampaignId, id));
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter a title.")]
        [StringLength(ThreadLimits.TitleMaxLength, ErrorMessage = "The title can be at most {1} characters.")]
        public string? Title { get; set; }
    }
}
