@page "/campaigns/new"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations

@inject ICampaignService CampaignService
@inject NavigationManager NavigationManager

<PageTitle>Create campaign</PageTitle>

<h1>Create campaign</h1>

<div class="row">
    <div class="col-lg-8">
        <EditForm Model="Input" method="post" OnValidSubmit="CreateAsync" FormName="create-campaign">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger py-2">@errorMessage</div>
            }

            <div class="mb-3">
                <label for="Input.Name" class="form-label">Name</label>
                <InputText @bind-Value="Input.Name" id="Input.Name" class="form-control" maxlength="@CampaignLimits.NameMaxLength" />
                <ValidationMessage For="() => Input.Name" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="Input.Description" class="form-label">Description</label>
                <InputTextArea @bind-Value="Input.Description" id="Input.Description" class="form-control" rows="6" maxlength="@CampaignLimits.DescriptionMaxLength" />
                <div class="form-text">At most @CampaignLimits.DescriptionMaxLength characters. Shown in the campaign list.</div>
                <ValidationMessage For="() => Input.Description" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="Input.MaxPlayers" class="form-label">Max players</label>
                <InputNumber @bind-Value="Input.MaxPlayers" id="Input.MaxPlayers" class="form-control" style="max-width: 10rem"
                             min="@CampaignLimits.MinPlayers" max="@CampaignLimits.MaxPlayers" />
                <div class="form-text">Leave empty for no limit.</div>
                <ValidationMessage For="() => Input.MaxPlayers" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Create campaign</button>
            <a href="" class="btn btn-link">Cancel</a>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private string? errorMessage;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task CreateAsync()
    {
        var user = (await AuthenticationState).User;
        var userId = user.GetUserId() ?? throw new InvalidOperationException("Inloggad användare saknar id.");

        int campaignId;
        try
        {
            campaignId = await CampaignService.CreateCampaignAsync(userId, new NewCampaign(Input.Name, Input.Description, Input.MaxPlayers));
        }
        catch (CampaignRuleException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        NavigationManager.NavigateTo($"campaigns/{campaignId}");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(CampaignLimits.NameMaxLength, ErrorMessage = "The name can be at most {1} characters.")]
        public string Name { get; set; } = "";

        [StringLength(CampaignLimits.DescriptionMaxLength, ErrorMessage = "The description can be at most {1} characters.")]
        public string? Description { get; set; }

        [Range(CampaignLimits.MinPlayers, CampaignLimits.MaxPlayers, ErrorMessage = "Enter a value between {1} and {2}.")]
        public int? MaxPlayers { get; set; }
    }
}
