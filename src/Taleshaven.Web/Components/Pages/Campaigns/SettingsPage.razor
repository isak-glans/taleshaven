@page "/campaigns/{CampaignId:int}/settings"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Taleshaven.Core.Text
@using Taleshaven.Web.Components.Account
@using Taleshaven.Web.Components.Account.Shared

@* GM administrerar kampanjen: namn, beskrivning, max antal spelare, status, taggar, standardtärning och radering
   (A-2, A-3, B46, B47). *@

@inject ICampaignService CampaignService
@inject IdentityRedirectManager RedirectManager
@inject NavigationManager NavigationManager

@if (campaign is null)
{
    return;
}

<PageTitle>Settings · @campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="CampaignTab.Settings" />

@if (!CampaignPermissions.CanManageCampaign(campaign.ViewerRole))
{
    <div class="alert alert-warning">Only the campaign's GM can change the campaign.</div>
    return;
}

<div class="settings">
    <h2 class="h4">Settings</h2>
    <StatusMessage Message="@settingsError" />

    <EditForm Model="Input" method="post" OnValidSubmit="SaveAsync" FormName="settings">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="mb-3">
            <label for="Input.Name" class="form-label">Name</label>
            <InputText @bind-Value="Input.Name" id="Input.Name" class="form-control" maxlength="@CampaignLimits.NameMaxLength" />
        </div>

        <div class="mb-3">
            <label for="Input.Description" class="form-label">Description</label>
            <InputTextArea @bind-Value="Input.Description" id="Input.Description" class="form-control" rows="5"
                           maxlength="@CampaignLimits.DescriptionMaxLength" />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-4">
                <label for="Input.MaxPlayers" class="form-label">Max players</label>
                <InputNumber @bind-Value="Input.MaxPlayers" id="Input.MaxPlayers" class="form-control"
                             min="@CampaignLimits.MinPlayers" max="@CampaignLimits.MaxPlayers" />
                <div class="form-text">Empty = no limit. Currently @campaign.Players.Count @(campaign.Players.Count == 1 ? "player" : "players").</div>
            </div>
            <div class="col-sm-8">
                <label for="Input.Status" class="form-label">Status</label>
                <InputSelect @bind-Value="Input.Status" id="Input.Status" class="form-select">
                    @foreach (var status in Enum.GetValues<CampaignStatus>())
                    {
                        <option value="@status">@StatusText(status)</option>
                    }
                </InputSelect>
                @* Sidan är statisk, så förklaringen visas för alla statusar i stället för att följa valet. *@
                <ul class="form-text ps-3 mb-0">
                    @foreach (var status in Enum.GetValues<CampaignStatus>())
                    {
                        <li><strong>@StatusText(status):</strong> @StatusHelp(status)</li>
                    }
                </ul>
            </div>
        </div>

        <CampaignTagRollFields Prefix="Input" Tags="@Input.Tags" DefaultRoll="@Input.DefaultRoll" UsedTags="usedTags" />

        <button type="submit" class="btn btn-primary">Save settings</button>
    </EditForm>

    <section class="danger-zone border border-danger rounded p-3 mt-5">
        <h2 class="h5 text-danger">Delete the campaign</h2>
        <p class="mb-2">
            Everything in the campaign is deleted for good: threads, posts, dice rolls, characters, applications and players.
            This can't be undone. If you just want to end the campaign, set the status to <em>Archived</em> instead.
        </p>
        @if (deleteError is not null)
        {
            <div class="alert alert-danger py-2">@deleteError</div>
        }
        <form method="post" @formname="delete-campaign" @onsubmit="DeleteAsync">
            <AntiforgeryToken />
            <label for="confirm-name" class="form-label">Type the campaign's name, <strong>@campaign.Name</strong>, to confirm</label>
            <div class="d-flex flex-wrap gap-2">
                <input id="confirm-name" name="DeleteInput.ConfirmationName" class="form-control confirm-name" autocomplete="off" />
                <button type="submit" class="btn btn-danger">Delete the campaign for good</button>
            </div>
        </form>
    </section>
</div>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "settings")]
    private SettingsInputModel Input { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "delete-campaign")]
    private DeleteInputModel? DeleteInput { get; set; }

    private string userId = "";
    private CampaignDetails? campaign;
    private string? settingsError;
    private string? deleteError;
    private IReadOnlyList<string> usedTags = [];

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign is null)
        {
            NavigationManager.NotFound();
            return;
        }

        // Vid visning fylls formuläret med kampanjens värden; vid POST kommer värdena från formuläret.
        Input ??= new SettingsInputModel
        {
            Name = campaign.Name,
            Description = campaign.Description,
            MaxPlayers = campaign.MaxPlayers,
            Status = campaign.Status,
            Tags = TagList.Format(campaign.Tags),
            DefaultRoll = campaign.DefaultRoll,
        };
        usedTags = [.. (await CampaignService.GetCampaignTagsAsync()).Except(campaign.Tags)];
        DeleteInput ??= new();
    }

    private async Task SaveAsync()
    {
        try
        {
            await CampaignService.UpdateCampaignAsync(CampaignId, userId,
                new CampaignSettings(Input.Name, Input.Description, Input.MaxPlayers, Input.Status, Input.Tags, Input.DefaultRoll));
        }
        catch (CampaignRuleException ex)
        {
            settingsError = $"Error: {ex.Message}";
            return;
        }

        RedirectManager.RedirectToWithStatus($"campaigns/{CampaignId}/settings", "The settings have been saved.", HttpContext);
    }

    private async Task DeleteAsync()
    {
        try
        {
            await CampaignService.DeleteCampaignAsync(CampaignId, userId, DeleteInput?.ConfirmationName);
        }
        catch (CampaignRuleException ex)
        {
            deleteError = ex.Message;
            return;
        }

        NavigationManager.NavigateTo("");
    }

    private static string StatusText(CampaignStatus status) => status switch
    {
        CampaignStatus.OpenForApplications => "Open for applications",
        CampaignStatus.Ongoing => "Ongoing",
        CampaignStatus.Closed => "Closed",
        CampaignStatus.Archived => "Archived",
        _ => status.ToString(),
    };

    private static string StatusHelp(CampaignStatus status) => status switch
    {
        CampaignStatus.OpenForApplications => "The game is on and new players can apply.",
        CampaignStatus.Ongoing => "The game is on but not accepting applications.",
        CampaignStatus.Closed => "Paused. Players can read but not post; the GM can still post.",
        CampaignStatus.Archived => "Finished. Everything can still be read; players can't post.",
        _ => "",
    };

    private sealed class SettingsInputModel
    {
        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(CampaignLimits.NameMaxLength, ErrorMessage = "The name can be at most {1} characters.")]
        public string? Name { get; set; }

        [StringLength(CampaignLimits.DescriptionMaxLength, ErrorMessage = "The description can be at most {1} characters.")]
        public string? Description { get; set; }

        [Range(CampaignLimits.MinPlayers, CampaignLimits.MaxPlayers, ErrorMessage = "Max players must be between {1} and {2}.")]
        public int? MaxPlayers { get; set; }

        public CampaignStatus Status { get; set; }

        public string? Tags { get; set; }

        public string? DefaultRoll { get; set; }
    }

    private sealed class DeleteInputModel
    {
        public string? ConfirmationName { get; set; }
    }
}
