@page "/campaigns/{CampaignId:int}/threads/{ThreadId:int}/complete"
@page "/campaigns/{CampaignId:int}/threads/{ThreadId:int}/chronicle"
@attribute [Authorize]
@rendermode InteractiveServer

@* Avsluta en tråd (B32) och skriva krönikan för en Story-tråd (B33). Samma sida används för att skriva eller ändra
   krönikan i efterhand. Krönikan är valfri när tråden avslutas och kan skrivas senare. *@

@inject ICampaignService CampaignService
@inject IThreadService ThreadService
@inject NavigationManager NavigationManager

@if (!loaded || LoadedCampaign is null || LoadedThread is null)
{
    return;
}

<PageTitle>@Heading · @LoadedCampaign.Name</PageTitle>

<CampaignHeader Campaign="LoadedCampaign" Active="CampaignTab.Threads" />

@if (!LoadedThread.CanManage)
{
    <div class="alert alert-warning">Only the campaign's GM can manage threads.</div>
    return;
}

<div class="thread-chronicle-editor">
    <h2 class="h4 mb-1">@Heading</h2>

    @if (Completing && LoadedThread.Status == ThreadStatus.Completed)
    {
        <p class="text-secondary">The thread is already completed.</p>
        <a class="btn btn-link px-0" href="@ThreadLinks.Thread(CampaignId, ThreadId)">Back to the thread</a>
    }
    else if (LoadedThread.Kind == ThreadKind.Story)
    {
        <p class="text-secondary">
            @if (Completing)
            {
                <text>Write a summary of what happened. It replaces the introduction at the top of the thread, so new players can catch up
                without reading every post. You can leave it empty and write it later.</text>
            }
            else
            {
                <text>The chronicle is shown instead of the introduction at the top of the completed thread. The posts stay as they are.</text>
            }
        </p>
        <MarkdownEditor MaxLength="ThreadLimits.ChronicleMaxLength" DraftKey="@($"chronicle-{ThreadId}")"
                        InitialText="@LoadedThread.Chronicle" OnSubmit="SaveAsync" AllowEmpty="true"
                        SubmitText="@(Completing ? "Complete thread" : "Save chronicle")" ShortcutHint="Ctrl+Enter saves"
                        Label="Chronicle" Rows="12"
                        Placeholder="The party left the harbour and followed the green light along the causeway…" />
        <a class="btn btn-link px-0 mt-2" href="@ThreadLinks.Thread(CampaignId, ThreadId)">Cancel</a>
    }
    else if (Completing)
    {
        <p class="text-secondary">Players can no longer post in a completed thread. You can reopen it later.</p>
        @if (error is not null)
        {
            <div class="text-danger mb-2" role="alert">@error</div>
        }
        <button type="button" class="btn btn-primary" @onclick="CompleteDiscussionAsync">Complete thread</button>
        <a class="btn btn-link" href="@ThreadLinks.Thread(CampaignId, ThreadId)">Cancel</a>
    }
    else
    {
        <p class="text-secondary">Only story threads have a chronicle.</p>
    }
</div>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [Parameter]
    public int ThreadId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [PersistentState]
    public CampaignDetails? LoadedCampaign { get; set; }

    [PersistentState]
    public ThreadDetails? LoadedThread { get; set; }

    private string userId = "";
    private bool loaded;
    private string? error;

    private bool Completing => NavigationManager.Uri.Split('?')[0].EndsWith("/complete", StringComparison.Ordinal);

    private string Heading => Completing ? $"Complete “{LoadedThread?.Title}”" : $"Chronicle – {LoadedThread?.Title}";

    protected override async Task OnParametersSetAsync()
    {
        userId = (await AuthenticationState).User.GetUserId() ?? "";

        if (LoadedCampaign?.Id != CampaignId)
            LoadedCampaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (LoadedCampaign is not null && LoadedThread?.Id != ThreadId)
            LoadedThread = await ThreadService.GetThreadAsync(CampaignId, ThreadId, userId);

        if (LoadedCampaign is null || LoadedThread is null)
        {
            NavigationManager.NotFound();
            return;
        }

        loaded = true;
    }

    private async Task<string?> SaveAsync(string chronicle)
    {
        try
        {
            if (Completing)
                await ThreadService.CompleteThreadAsync(CampaignId, ThreadId, userId, chronicle);
            else
                await ThreadService.SetChronicleAsync(CampaignId, ThreadId, userId, chronicle);
        }
        catch (CampaignRuleException ex)
        {
            return ex.Message;
        }

        NavigationManager.NavigateTo(ThreadLinks.Thread(CampaignId, ThreadId));
        return null;
    }

    private async Task CompleteDiscussionAsync()
    {
        error = await SaveAsync("");
    }
}
