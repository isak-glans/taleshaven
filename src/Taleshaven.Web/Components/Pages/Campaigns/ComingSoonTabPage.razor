@page "/campaigns/{CampaignId:int}/chronicle"
@page "/campaigns/{CampaignId:int}/characters"
@attribute [Authorize]

@* Tillfällig sida för flikar som inte är byggda än. *@

@inject ICampaignService CampaignService
@inject NavigationManager NavigationManager

@if (campaign is null)
{
    return;
}

<PageTitle>@TabName · @campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="tab" />

<p class="text-secondary">@TabName kommer i ett senare steg.</p>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private CampaignDetails? campaign;
    private CampaignTab tab;

    private string TabName => tab == CampaignTab.Chronicle ? "Krönikan" : "Karaktärerna";

    protected override async Task OnInitializedAsync()
    {
        tab = NavigationManager.Uri.Contains("/chronicle", StringComparison.OrdinalIgnoreCase)
            ? CampaignTab.Chronicle
            : CampaignTab.Characters;

        var userId = (await AuthenticationState).User.GetUserId() ?? "";
        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign is null)
            NavigationManager.NotFound();
    }
}
