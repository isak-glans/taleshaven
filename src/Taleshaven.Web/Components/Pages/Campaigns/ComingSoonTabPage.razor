@page "/campaigns/{CampaignId:int}/characters"
@attribute [Authorize]

@* Tillfällig sida för fliken Karaktärer tills den är byggd. *@

@inject ICampaignService CampaignService
@inject NavigationManager NavigationManager

@if (campaign is null)
{
    return;
}

<PageTitle>Karaktärer · @campaign.Name</PageTitle>

<CampaignHeader Campaign="campaign" Active="CampaignTab.Characters" />

<p class="text-secondary">Karaktärerna kommer i ett senare steg.</p>

@code {
    [Parameter]
    public int CampaignId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private CampaignDetails? campaign;

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthenticationState).User.GetUserId() ?? "";
        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign is null)
            NavigationManager.NotFound();
    }
}
