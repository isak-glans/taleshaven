@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Taleshaven.Core.Portraits
@using Taleshaven.Core.Users
@using Taleshaven.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IAccountService Accounts
@inject IPortraitService Portraits

<PageTitle>Profile</PageTitle>

<h3>Profile</h3>
<StatusMessage />

@* Profilbild ur porträttbiblioteket (B50). Sidan är statisk: sökningen är ett GET-formulär och valet ett vanligt
   formulär med radioknappar, så att inloggningskakan (och bilden i menyn) kan förnyas när bilden sparas.
   Ett klick på en bild sparar den direkt (B54); knappen finns bara kvar för den som inte har JavaScript. *@
<section class="profile-picture mt-3" id="picture">
    <h4>Profile picture</h4>
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <Avatar Name="@(user?.DisplayName ?? "?")" ImageUrl="@current?.Url" ColorKey="@(user?.Id ?? "")" Size="96" />
        <div>
            <p class="mb-2 text-secondary small">
                Shown when you post without a character (and as the GM narrator), in player lists and in the menu.
                Without a picture, your initials are shown. <strong>Click a picture below to use it</strong> – it's saved right away.
            </p>
            @if (current is not null)
            {
                <form method="post" @formname="remove-picture" @onsubmit="RemovePictureAsync">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove picture</button>
                </form>
            }
        </div>
    </div>

    <form method="get" action="Account/Manage#picture" class="d-flex flex-wrap gap-2 mb-2 profile-picture-search" role="search">
        <input type="search" name="q" value="@SearchText" class="form-control" style="max-width: 24rem"
               placeholder="Search tags, e.g. profile elf" aria-label="Search pictures by tag" />
        @* En tom sökning ska visa alla bilder, inte bara #profile; en tom q-parameter kommer fram som null. *@
        <input type="hidden" name="all" value="true" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        @if (SearchText != "")
        {
            <a class="btn btn-link px-1 profile-picture-all" href="Account/Manage?all=true#picture">Show all pictures</a>
        }
    </form>
    @if (fellBackToAll)
    {
        <p class="small text-secondary profile-picture-fallback">No pictures are tagged #@UserLimits.ProfilePortraitTag yet, so the whole library is shown.</p>
    }

    @if (results is null || results.Portraits.Count == 0)
    {
        <p class="text-secondary">@(SearchText.Length > 0 ? "No pictures have those tags." : "The library is empty. Administrators and managers add pictures.")</p>
    }
    else
    {
        <form method="post" @formname="picture" @onsubmit="SavePictureAsync">
            <AntiforgeryToken />
            <div class="profile-picture-grid" role="radiogroup" aria-label="Pictures">
                @foreach (var portrait in results.Portraits)
                {
                    <label class="profile-picture-choice" title="@PortraitTags.Format(portrait.Tags)">
                        <input type="radio" name="Picture.PortraitId" value="@portrait.Id" checked="@(portrait.Id == current?.PortraitId)"
                               onchange="this.form.requestSubmit()" />
                        <img src="@portrait.Url" alt="@PortraitTags.Format(portrait.Tags)" width="80" height="80" loading="lazy" />
                    </label>
                }
            </div>
            <noscript><button type="submit" class="btn btn-primary mt-3">Use selected picture</button></noscript>
        </form>
        <div class="profile-picture-pager mt-3" style="max-width: 44rem">
            <Pager Page="pageNumber" PageCount="pageCount" ShowLatest="false" Href="PageHref" />
        </div>
    }
</section>

<section class="profile-details mt-5">
    <h4>Name and about me</h4>
<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <input type="text" value="@username" id="username" class="form-control" placeholder="Email" disabled />
                <label for="username" class="form-label">Email</label>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.DisplayName" id="Input.DisplayName" class="form-control" placeholder="Display name" />
                <label for="Input.DisplayName" class="form-label">Display name</label>
                <ValidationMessage For="() => Input.DisplayName" class="text-danger" />
            </div>
            @* Visas på profilsidan, som andra når via namnet eller bilden i trådarna (B52). *@
            <div class="mb-3">
                <label for="Input.About" class="form-label">About me</label>
                <InputTextArea @bind-Value="Input.About" id="Input.About" class="form-control" rows="6" maxlength="@UserLimits.AboutMaxLength"
                               placeholder="A few words about yourself: favourite games, how often you post, what you enjoy in a story…" />
                <div class="form-text">
                    Markdown, at most @UserLimits.AboutMaxLength characters. Shown on <a href="@UserLinks.Profile(user?.Id ?? "")">your profile page</a>.
                </div>
                <ValidationMessage For="() => Input.About" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Save name and about me</button>
        </EditForm>
    </div>
</div>
</section>


@code {
    private ApplicationUser? user;
    private string? username;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "picture")]
    private PictureModel? Picture { get; set; }

    /// <summary>Sökningen i porträttbiblioteket. Utan sökning visas bilder taggade #profile (B50); tom sökning visar alla.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "all")]
    private bool All { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? PageQuery { get; set; }

    private int pageNumber = 1;
    private int pageCount = 1;

    /// <summary>Bilder per sida i väljaren (B51; 40 sedan B53).</summary>
    private const int PageSize = 40;

    private ProfilePortrait? current;
    private PortraitPage? results;
    private bool fellBackToAll;

    private string SearchText => Query?.Trim() is { Length: > 0 } query ? query : All ? "" : UserLimits.ProfilePortraitTag;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        username = await UserManager.GetUserNameAsync(user);

        Input.DisplayName ??= user.DisplayName;
        Input.About ??= user.About;

        current = await Accounts.GetProfilePortraitAsync(user.Id);
        // Hela biblioteket visas om inga bilder har taggen #profile; sidnumret begränsas till sökningens sidor.
        var search = SearchText;
        var count = (await Portraits.SearchAsync(search, 0, excludeIcons: true)).TotalCount;
        if (search == UserLimits.ProfilePortraitTag && Query is null && count == 0)
        {
            fellBackToAll = true;
            search = "";
            count = (await Portraits.SearchAsync(search, 0, excludeIcons: true)).TotalCount;
        }
        pageCount = Paging.PageCount(count, PageSize);
        pageNumber = Paging.Clamp(PageQuery ?? 1, pageCount);
        results = await Portraits.SearchAsync(search, PageSize, (pageNumber - 1) * PageSize, excludeIcons: true);
    }

    // Sidlänkarna behåller sökningen (B51).
    private string PageHref(int page)
    {
        var query = new List<string>();
        if (Query?.Trim() is { Length: > 0 } q)
            query.Add("q=" + Uri.EscapeDataString(q));
        else if (All)
            query.Add("all=true");
        if (page > 1)
            query.Add($"page={page}");
        return "Account/Manage" + (query.Count == 0 ? "" : "?" + string.Join("&", query)) + "#picture";
    }

    private async Task SavePictureAsync()
    {
        if (Picture?.PortraitId is not { } portraitId)
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Error: Choose a picture first.", HttpContext);
            return;
        }

        await SetPictureAsync(portraitId, "Your profile picture has been saved.");
    }

    private Task RemovePictureAsync() => SetPictureAsync(null, "Your profile picture has been removed.");

    private async Task SetPictureAsync(int? portraitId, string message)
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        try
        {
            await Accounts.SetProfilePortraitAsync(user.Id, portraitId);
        }
        catch (CampaignRuleException ex)
        {
            RedirectManager.RedirectToCurrentPageWithStatus($"Error: {ex.Message}", HttpContext);
            return;
        }

        // Inloggningskakan förnyas så att bilden syns i menyn direkt; fabriken läser bilden ur databasen.
        user.PortraitId = portraitId;
        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus(message, HttpContext);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var displayName = Input.DisplayName!.Trim();
        var about = Input.About?.Trim() ?? "";
        if (displayName != user.DisplayName || about != user.About)
        {
            user.DisplayName = displayName;
            user.About = about;
            var result = await UserManager.UpdateAsync(user);
            if (!result.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Error: Your profile could not be saved.", HttpContext);
                return;
            }
        }

        // Förnyar inloggningskakan så att det nya visningsnamnet syns direkt.
        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Your profile has been saved.", HttpContext);
    }

    private sealed class PictureModel
    {
        public int? PortraitId { get; set; }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter a display name.")]
        [StringLength(UserLimits.DisplayNameMaxLength, MinimumLength = UserLimits.DisplayNameMinLength,
            ErrorMessage = "The display name must be {2}–{1} characters.")]
        public string? DisplayName { get; set; }

        [StringLength(UserLimits.AboutMaxLength, ErrorMessage = "About me can be at most {1} characters.")]
        public string? About { get; set; }
    }
}
