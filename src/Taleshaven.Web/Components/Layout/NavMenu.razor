@implements IDisposable

@using Taleshaven.Core.Site

@inject NavigationManager NavigationManager
@inject ISiteRoleService RoleService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Taleshaven</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Campaigns
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="campaigns/new">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Create campaign
                    </NavLink>
                </div>
                @if (SitePermissions.CanManagePortraits(siteRoles))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="portraits">
                            <span class="bi bi-image-nav-menu" aria-hidden="true"></span> Portraits
                        </NavLink>
                    </div>
                }
                @if (SitePermissions.CanManageRoles(siteRoles))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/roles">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Roles
                        </NavLink>
                    </div>
                }
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-profile" href="Account/Manage">
                        @* Profilbilden eller initialerna (B50) i stället för en ikon. *@
                        <span class="nav-avatar" aria-hidden="true">
                            <Avatar Name="@context.User.GetDisplayName()" ImageUrl="@context.User.GetAvatarUrl()" ColorKey="@(context.User.GetUserId() ?? "")" Size="24" />
                        </span>
                        @context.User.GetDisplayName()
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Log out
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Create account
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Log in
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private IReadOnlySet<SiteRole> siteRoles = new HashSet<SiteRole>();

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        // Sajtroller läses från databasen vid varje sidvisning, så att en ny roll syns utan att man loggar in igen (B18).
        if ((await AuthenticationState).User.GetUserId() is { } userId)
            siteRoles = await RoleService.GetRolesAsync(userId);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
